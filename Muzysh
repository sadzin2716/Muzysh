    floater.BackgroundColor3 = self.Theme.CardBg
    floater.Image = "rbxassetid://10734996259" -- Ícone elegante de engrenagem/painel
    floater.ScaleType = Enum.ScaleType.Fit
    floater.Parent = self.ScreenGui

    local c = Instance.new("UICorner") c.CornerRadius = UDim.new(1, 0) c.Parent = floater
    local s = Instance.new("UIStroke") s.Color = self.Theme.Stroke s.Thickness = 1 s.Parent = floater

    MakeDraggable(floater, floater)
    floater.MouseButton1Click:Connect(function() self:RestoreWindow() end)
    self.FloatingBtn = floater
end

