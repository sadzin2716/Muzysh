    local function ToggleUI(forceState)
        if forceState ~= nil then
            UIVisible = forceState
        else
            UIVisible = not UIVisible
        end

        if UIVisible then
            MobileToggle.Visible = false
            MainFrame.Visible = true
            CreateTween(MainFrame, {Size = UDim2.new(0, 600, 0, 400)}, 0.3)
        else
            CreateTween(MainFrame, {Size = UDim2.new(0, 0, 0, 0)}, 0.3)
            task.wait(0.3)
            MainFrame.Visible = false
            if KeyPassed then
                MobileToggle.Visible = true -- Só mostra o botão se já tiver passado do sistema de Key
            end
        end
    end

    MinimizeBtn.MouseButton1Click:Connect(function() ToggleUI(false) end)
    MobileToggle.MouseButton1Click:Connect(function() ToggleUI(true) end)

    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if not gameProcessed and input.KeyCode == ToggleKey then
            if KeyPassed then
                ToggleUI()
            end
        end
    end)

    -- Sistema de Validação Integrado (Key System)
    if KeySystem then
        MainFrame.Visible = false
