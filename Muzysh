        trackBtn.Size = UDim2.new(1, 0, 1, 0)
        trackBtn.BackgroundTransparency = 1
        trackBtn.Text = ""
        trackBtn.Parent = trackContainer

        local sliding = false

        local function updateFromPosition(inputPosition)
            local percent = math.clamp((inputPosition.X - trackContainer.AbsolutePosition.X) / trackContainer.AbsoluteSize.X, 0, 1)
            local rawValue = min + ((max - min) * percent)
            
            if isDecimal then
                value = math.round(rawValue * 10) / 10 -- Arredonda para 1 casa decimal
            else
                value = math.floor(rawValue)
            end
            
            valLabel.Text = tostring(value)
            CreateTween(fill, 0.1, {Size = UDim2.new(percent, 0, 1, 0)})
            CreateTween(snap, 0.1, {Position = UDim2.new(percent, -8, 0.5, -8)})
            callback(value)
        end

        trackBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                pageFrame.ScrollingEnabled = false
                updateFromPosition(input.Position)
            end
        end)

        trackBtn.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromPosition(input.Position)
            end
        end)

        trackBtn.InputEnded:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                sliding = false
                pageFrame.ScrollingEnabled = true
            end
        end)

        trackContainer.Destroying:Connect(function()
            if sliding then
                pageFrame.ScrollingEnabled = true
            end
        end)
    end

    function elements:CreateDropdown(dropText, list, callback)
        callback = callback or function() end
        local isOpened = false

        local dropFrame = Instance.new("Frame")
        dropFrame.Size = UDim2.new(1, 0, 0, 40)
        dropFrame.BackgroundColor3 = self.Theme.CardBg
        dropFrame.ClipsDescendants = true
        dropFrame.Parent = pageFrame

        local dfCorner = Instance.new("UICorner")
        dfCorner.CornerRadius = UDim.new(0, 8)
        dfCorner.Parent = dropFrame

        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, 0, 0, 40)
        mainBtn.BackgroundTransparency = 1
        mainBtn.Text = "  " .. dropText
        mainBtn.TextColor3 = self.Theme.TextColor
        mainBtn.Font = self.Theme.Font
        mainBtn.TextSize = 14
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.Parent = dropFrame

        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 40, 0, 40)
        arrow.Position = UDim2.new(1, -40, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▼"
        arrow.TextColor3 = self.Theme.TextMuted
        arrow.Font = self.Theme.Font
        arrow.TextSize = 12
        arrow.Parent = mainBtn

        -- Trocado Frame por ScrollingFrame para evitar transbordamento visual
        local listHolder = Instance.new("ScrollingFrame")
        listHolder.Size = UDim2.new(1, -20, 1, -45)
        listHolder.Position = UDim2.new(0, 10, 0, 42)
        listHolder.BackgroundTransparency = 1
        listHolder.ScrollBarThickness = 2
        listHolder.ScrollBarImageColor3 = self.Theme.Accent
        listHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
        listHolder.Parent = dropFrame

        local listLayout = Instance.new("UIListLayout")
        listLayout.Padding = UDim.new(0, 4)
        listLayout.Parent = listHolder

        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            listHolder.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
        end)

        for _, opt in ipairs(list) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, 0, 0, 30)
            optBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
            optBtn.Text = opt
            optBtn.TextColor3 = self.Theme.TextMuted
            optBtn.Font = self.Theme.Font
            optBtn.TextSize = 13
            optBtn.Parent = listHolder

            local obc = Instance.new("UICorner")
            obc.CornerRadius = UDim.new(0, 6)
            obc.Parent = optBtn

            optBtn.MouseButton1Click:Connect(function()
                mainBtn.Text = "  " .. dropText .. " (" .. opt .. ")"
                isOpened = false
                CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 40)})
                CreateTween(arrow, 0.2, {Rotation = 0})
                callback(opt)
            end)
        end

        mainBtn.MouseButton1Click:Connect(function()
            isOpened = not isOpened
            if isOpened then
                local contentHeight = 45 + (#list * 34)
                -- O Dropdown agora é limitado a 150 pixels de altura para não estourar a tela
                local finalHeight = math.clamp(contentHeight, 40, 150)
                CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, finalHeight)})
                CreateTween(arrow, 0.2, {Rotation = 180})
            else
                CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 40)})
                CreateTween(arrow, 0.2, {Rotation = 0})
            end
        end)
    end

    function elements:CreateTextBox(placeholder, callback)
        callback = callback or function() end
        local boxFrame = Instance.new("Frame")
        boxFrame.Size = UDim2.new(1, 0, 0, 40)
        boxFrame.BackgroundColor3 = self.Theme.CardBg
        boxFrame.Parent = pageFrame

        local bfCorner = Instance.new("UICorner")
        bfCorner.CornerRadius = UDim.new(0, 8)
        bfCorner.Parent = boxFrame

        local stroke = Instance.new("UIStroke")
        stroke.Thickness = 1
        stroke.Color = self.Theme.Stroke
        stroke.Parent = boxFrame

        local box = Instance.new("TextBox")
        box.Size = UDim2.new(1, -24, 1, 0)
        box.Position = UDim2.new(0, 12, 0, 0)
        box.BackgroundTransparency = 1
        box.PlaceholderText = placeholder
        box.PlaceholderColor3 = self.Theme.TextMuted
        box.Text = ""
        box.TextColor3 = self.Theme.TextColor
        box.Font = self.Theme.Font
        box.TextSize = 14
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.Parent = boxFrame

        box.Focused:Connect(function() CreateTween(stroke, 0.2, {Color = self.Theme.Accent}) end)
        box.FocusLost:Connect(function(enterPressed)
            CreateTween(stroke, 0.2, {Color = self.Theme.Stroke})
            callback(box.Text, enterPressed)
        end)
    end

    return elements
end

return Muzysh
