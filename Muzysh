			Tween(tabBtn, 0.15, {BackgroundTransparency = 0.9, BackgroundColor3 = Color3.fromRGB(60, 60, 60)})
			Tween(tabBtn, 0.15, {TextColor3 = Theme.TextColor})
		end
	end)
	local tabHoverOut = tabBtn.MouseLeave:Connect(function()
		if self._currentPage ~= pageFrame then
			Tween(tabBtn, 0.15, {BackgroundTransparency = 1, BackgroundColor3 = Color3.fromRGB(30, 30, 30)})
			Tween(tabBtn, 0.15, {TextColor3 = Theme.TextMuted})
		end
	end)
	janitor:Add(tabHoverIn)
	janitor:Add(tabHoverOut)

	local function selectPage()
		if self._pageTransitioning then return end
		self._pageTransitioning = true

		local previousPage = self._currentPage

		if previousPage then
			self._pageAnimManager:Tween(previousPage, 0.15, {BackgroundTransparency = 1}, Enum.EasingStyle.Quart)
			for _, child in ipairs(previousPage:GetChildren()) do
				if child:IsA("GuiObject") then
					self._pageAnimManager:Tween(child, 0.1, {BackgroundTransparency = 1})
				end
			end
			task.delay(0.15, function()
				previousPage.Visible = false
			end)
		end

		for t, ind in pairs(self.Tabs) do
			Tween(t, 0.2, {TextColor3 = Theme.TextMuted, BackgroundTransparency = 1})
			Tween(ind, 0.2, {Size = UDim2.new(0, 3, 0, 0), Position = UDim2.new(0, 0, 0.5, 0), BackgroundTransparency = 1})
		end

		pageFrame.Visible = true
		pageFrame.BackgroundTransparency = 1
		self._currentPage = pageFrame

		self._pageAnimManager:Tween(pageFrame, 0.2, {BackgroundTransparency = 0}, Enum.EasingStyle.Quart)

		task.delay(0.1, function()
			if self._currentPage ~= pageFrame then return end
			for _, child in ipairs(pageFrame:GetChildren()) do
				if child:IsA("Frame") and child.Name ~= "UIListLayout" and child.Name ~= "UIPadding" then
					child.BackgroundTransparency = 1
					self._pageAnimManager:Tween(child, 0.2, {BackgroundTransparency = 0})
				end
			end
			self._pageTransitioning = false
		end)

		Tween(tabBtn, 0.2, {TextColor3 = Theme.TextColor, BackgroundTransparency = 0.8, BackgroundColor3 = Theme.Accent})
		Tween(indicator, 0.25, {
			Size = UDim2.new(0, 4, 0, 20),
			Position = UDim2.new(0, 0, 0.2, 0),
			BackgroundTransparency = 0,
			BackgroundColor3 = Theme.Accent
		})
	end

	local tabClickConn = tabBtn.MouseButton1Click:Connect(selectPage)
	janitor:Add(tabClickConn)

	self.Pages[pageId] = pageFrame
	self.Tabs[tabBtn] = indicator

	if not self.FirstPage then
		self.FirstPage = selectPage
		task.spawn(selectPage)
	end

