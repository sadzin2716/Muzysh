local _tweens = {}
local function CreateTween(instance, duration, properties, style)
    if _tweens[instance] then _tweens[instance]:Cancel() end
    local tweenInfo = TweenInfo.new(duration, style or Enum.EasingStyle.Quint, Enum.EasingDirection.Out)
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    _tweens[instance] = tween
    tween.Completed:Connect(function()
        if _tweens[instance] == tween then _tweens[instance] = nil end
    end)
    return tween
end

local function MakeDraggable(dragFrame, moveFrame)
    local dragging, startMouse, startPos
    local moveConn, endConn

    local function stopDrag()
        dragging = false
        if moveConn then moveConn:Disconnect(); moveConn = nil end
        if endConn then endConn:Disconnect(); endConn = nil end
    end

    dragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startMouse = input.Position
            startPos = moveFrame.Position

            moveConn = UserInputService.InputChanged:Connect(function(inputObj)
                if dragging and (inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch) then
                    local delta = inputObj.Position - startMouse
                    moveFrame.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            end)

            endConn = UserInputService.InputEnded:Connect(function(inputObj)
                if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
                    stopDrag()
                end
            end)
        end
    end)
    dragFrame.Destroying:Connect(stopDrag)
end

function Muzysh:SaveConfig()
    if not self.ConfigName or not writefile then return end
    pcall(function()
        writefile(self.ConfigName .. ".json", HttpService:JSONEncode(self.Flags))
    end)
end

function Muzysh:LoadConfig()
    if not self.ConfigName or not isfile or not readfile then return end
    if isfile(self.ConfigName .. ".json") then
        local success, data = pcall(function()
            return HttpService:JSONDecode(readfile(self.ConfigName .. ".json"))
        end)
        if success and type(data) == "table" then
            self.SavedFlags = data
        end
    end
end

function Muzysh:DestroyWindow()
    if self._isDestroyed then return end
    self._isDestroyed = true

    for _, connection in pairs(self._connections) do
        if connection then connection:Disconnect() end
    end
    table.clear(self._connections)

    if self._mainTween then self._mainTween:Cancel() end

    self._mainTween = CreateTween(self.MainFrame, 0.3, { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)

    if self.FloatingBtn then self.FloatingBtn:Destroy() end
    task.delay(0.35, function()
        if self.ScreenGui and self.ScreenGui.Parent then self.ScreenGui:Destroy() end
    end)
end

function Muzysh:MinimizeWindow()
    if self._isMinimized or self._isDestroyed then return end
    self._isMinimized = true

    if self._mainTween then self._mainTween:Cancel() end
    self._mainTween = CreateTween(self.MainFrame, 0.3, { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }, Enum.EasingStyle.Quart)
    self._mainTween.Completed:Connect(function()
        if self._isDestroyed then return end
        self.MainFrame.Visible = false
    end)

    if not self.FloatingBtn then self:CreateFloatingButton() else self.FloatingBtn.Visible = true end
end

function Muzysh:RestoreWindow()
    if not self._isMinimized or self._isDestroyed then return end
    self._isMinimized = false

    if self.FloatingBtn then self.FloatingBtn.Visible = false end
    if self._mainTween then self._mainTween:Cancel() end

    self.MainFrame.Visible = true
    self._mainTween = CreateTween(self.MainFrame, 0.4, { Size = self.OriginalSize, BackgroundTransparency = 0 }, Enum.EasingStyle.Back)
end

