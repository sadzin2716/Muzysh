        local KeyInput = Instance.new("TextBox")
        KeyInput.Size = UDim2.new(0, 290, 0, 38)
        KeyInput.Position = UDim2.new(0.5, -145, 0.5, 2)
        KeyInput.BackgroundColor3 = Theme.ElementBg
        KeyInput.TextColor3 = Theme.Text
        KeyInput.Font = Enum.Font.Gotham
        KeyInput.TextSize = 13
        KeyInput.PlaceholderText = "Insira sua chave de acesso aqui..."
        KeyInput.PlaceholderColor3 = Color3.fromRGB(120, 120, 125)
        KeyInput.Text = ""
        KeyInput.Parent = KeyFrame
        Instance.new("UICorner", KeyInput).CornerRadius = UDim.new(0, 8)
        
        local InputStroke = Instance.new("UIStroke")
        InputStroke.Color = Color3.fromRGB(50, 50, 55)
        InputStroke.Thickness = 1
        InputStroke.Parent = KeyInput

        local SubmitBtn = Instance.new("TextButton")
        SubmitBtn.Size = UDim2.new(0, 140, 0, 36)
        SubmitBtn.Position = UDim2.new(0.5, -70, 1, -48)
        SubmitBtn.BackgroundColor3 = Theme.Accent
        SubmitBtn.Text = "Confirmar Key"
        SubmitBtn.TextColor3 = Theme.Text
