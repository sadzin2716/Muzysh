	floaterJanitor:Add(hoverOut)

	local floatDrag = DragController.new(floater, floater, floaterJanitor)
	floaterJanitor:Add(function() floatDrag:Destroy() end)

	local clickConn = floater.MouseButton1Click:Connect(function()
		self:Restore()
	end)
	floaterJanitor:Add(clickConn)

	self.FloatingBtn = floater
end

