function Muzysh:CreatePage(pageName, icon)
    -- Mudado para CanvasGroup para permitir efeito suave de Fade-In/Out
    local pageGroup = Instance.new("CanvasGroup")
    pageGroup.Name = pageName .. "_PageGroup"
    pageGroup.Size = UDim2.new(1, 0, 1, 0)
    pageGroup.BackgroundTransparency = 1
    pageGroup.GroupTransparency = 1
    pageGroup.Visible = false
    pageGroup.Parent = self.PageContainer

    local pageFrame = Instance.new("ScrollingFrame")
    pageFrame.Size = UDim2.new(1, 0, 1, 0)
    pageFrame.BackgroundTransparency = 1
    pageFrame.ScrollBarThickness = 3
    pageFrame.ScrollBarImageColor3 = self.Theme.Stroke
    pageFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    pageFrame.Parent = pageGroup

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = pageFrame

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        pageFrame.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 10)
    end)

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingRight = UDim.new(0, 6)
    pagePadding.Parent = pageFrame

    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(0, 124, 0, 34)
    tabBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = "  " .. pageName
    tabBtn.TextColor3 = self.Theme.TextMuted
    tabBtn.Font = self.Theme.Font
    tabBtn.TextSize = 13
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = self.Sidebar

    if icon then
        local iconLabel = Instance.new("ImageLabel")
        iconLabel.Size = UDim2.new(0, 16, 0, 16)
        iconLabel.Position = UDim2.new(0, 8, 0.5, -8)
        iconLabel.BackgroundTransparency = 1
        iconLabel.Image = typeof(icon) == "number" and "rbxassetid://" .. icon or icon
        iconLabel.ScaleType = Enum.ScaleType.Fit
        iconLabel.ImageColor3 = self.Theme.TextMuted
        iconLabel.Parent = tabBtn
        tabBtn.Text = "        " .. pageName
    end

    local tabCorner = Instance.new("UICorner")
    tabCorner.CornerRadius = UDim.new(0, 5)
    tabCorner.Parent = tabBtn

    -- Indicador vertical Fluent móvel
    local indicator = Instance.new("Frame")
    indicator.Size = UDim2.new(0, 3, 0, 0)
    indicator.Position = UDim2.new(0, 2, 0.5, 0)
    indicator.BackgroundColor3 = self.Theme.Accent
    indicator.BorderSizePixel = 0
    indicator.Parent = tabBtn

    local function SelectPage()
        for _, p in pairs(self.Pages) do 
            if p.Visible then
                CreateTween(p, 0.15, {GroupTransparency = 1}).Completed:Connect(function()
                    p.Visible = false
                end)
            end
        end
        for t, ind in pairs(self.Tabs) do
            CreateTween(t, 0.2, {TextColor3 = self.Theme.TextMuted, BackgroundTransparency = 1})
            local img = t:FindFirstChild("ImageLabel") or t:FindFirstChildWhichIsA("ImageLabel")
            if img then CreateTween(img, 0.2, {ImageColor3 = self.Theme.TextMuted}) end
            CreateTween(ind, 0.2, {Size = UDim2.new(0, 3, 0, 0), Position = UDim2.new(0, 2, 0.5, 0)})
        end
        
        pageGroup.Visible = true
        CreateTween(pageGroup, 0.25, {GroupTransparency = 0})
        CreateTween(tabBtn, 0.2, {TextColor3 = self.Theme.TextColor, BackgroundTransparency = 0.94})
        local activeImg = tabBtn:FindFirstChild("ImageLabel") or tabBtn:FindFirstChildWhichIsA("ImageLabel")
        if activeImg then CreateTween(activeImg, 0.2, {ImageColor3 = self.Theme.TextColor}) end
        CreateTween(indicator, 0.25, {Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 2, 0.5, -8)})
    end

    tabBtn.MouseButton1Click:Connect(SelectPage)
    
    tabBtn.MouseEnter:Connect(function()
        if not pageGroup.Visible then
            CreateTween(tabBtn, 0.15, {BackgroundTransparency = 0.97})
        end
    end)
    tabBtn.MouseLeave:Connect(function()
        if not pageGroup.Visible then
            CreateTween(tabBtn, 0.15, {BackgroundTransparency = 1})
        end
    end)

    table.insert(self.Pages, pageGroup)
    self.Tabs[tabBtn] = indicator

    if not self.FirstPage then
        self.FirstPage = SelectPage
        task.spawn(SelectPage)
    end

    local elements = {}
    local windowSelf = self

    -- Helper de design para padronizar estruturas Fluent (Cards com bordas finas)
    local function CreateCardFrame()
        local card = Instance.new("Frame")
        card.BackgroundColor3 = windowSelf.Theme.CardBg
        
        local cc = Instance.new("UICorner")
        cc.CornerRadius = UDim.new(0, 6)
        cc.Parent = card

        local cs = Instance.new("UIStroke")
