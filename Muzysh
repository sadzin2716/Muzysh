-- ============================================================================
-- JANITOR (GERENCIADOR DE LIMPEZA)
-- ============================================================================
local Janitor = {}
Janitor.__index = Janitor

function Janitor.new()
	return setmetatable({
		_connections = {},
		_instances = {},
		_functions = {},
	}, Janitor)
end

function Janitor:Add(item)
	if typeof(item) == "RBXScriptConnection" then
		table.insert(self._connections, item)
	elseif typeof(item) == "Instance" then
		table.insert(self._instances, item)
	elseif type(item) == "function" then
		table.insert(self._functions, item)
	end
	return item
end

function Janitor:Remove(item)
	for _, list in ipairs({self._connections, self._instances, self._functions}) do
		for i, v in ipairs(list) do
			if v == item then
				table.remove(list, i)
				return
			end
		end
	end
end

function Janitor:Destroy()
	for _, conn in ipairs(self._connections) do
		pcall(function() conn:Disconnect() end)
	end
	for _, instance in ipairs(self._instances) do
		pcall(function() instance:Destroy() end)
	end
	for _, func in ipairs(self._functions) do
		pcall(func)
	end
	self._connections = {}
	self._instances = {}
	self._functions = {}
end

-- ============================================================================
-- DRAG CONTROLLER (SISTEMA DE ARRASTO SEGURO)
-- ============================================================================
local DragController = {}
DragController.__index = DragController

function DragController.new(dragFrame, container, janitor)
	local self = setmetatable({
		_dragFrame = dragFrame,
		_container = container,
		_isDragging = false,
		_startMousePos = nil,
		_startContainerPos = nil,
		_moveConn = nil,
		_endConn = nil,
		_janitor = janitor,
	}, DragController)

	local function startDrag(input)
		self._isDragging = true
		self._startMousePos = input.Position
		self._startContainerPos = container.Position

		self._moveConn = UserInputService.InputChanged:Connect(function(inputObj)
			if inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch then
				local delta = inputObj.Position - self._startMousePos
				container.Position = UDim2.new(
					self._startContainerPos.X.Scale,
					self._startContainerPos.X.Offset + delta.X,
					self._startContainerPos.Y.Scale,
					self._startContainerPos.Y.Offset + delta.Y
				)
			end
		end)
		janitor:Add(self._moveConn)

		self._endConn = UserInputService.InputEnded:Connect(function(inputObj)
			if inputObj == input then
				self:StopDrag()
			end
		end)
		janitor:Add(self._endConn)
	end

	function self:StopDrag()
		if self._moveConn then
			self._moveConn:Disconnect()
			self._janitor:Remove(self._moveConn)
			self._moveConn = nil
		end
		if self._endConn then
			self._endConn:Disconnect()
			self._janitor:Remove(self._endConn)
			self._endConn = nil
		end
		self._isDragging = false
	end

	local beganConn = dragFrame.InputBegan:Connect(function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			startDrag(input)
		end
	end)
	janitor:Add(beganConn)

	function self:Destroy()
		self:StopDrag()
	end

	return self
end

