        local vs = cam.ViewportSize
        if vs.X < 600 or vs.Y < 400 then
            uiScale.Scale = math.min(vs.X / 620, vs.Y / 400)
        else
            uiScale.Scale = 1
        end
    end
    
    UpdateScale()
    
    local camConnection = workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function()
        local cam = workspace.CurrentCamera
        if cam then
            local vsConnection = cam:GetPropertyChangedSignal("ViewportSize"):Connect(UpdateScale)
            table.insert(self._connections, vsConnection)
            UpdateScale()
        end
    end)
    table.insert(self._connections, camConnection)

