		listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
			listScroller.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 8)
		end)

		local itemFrames = {}
		local itemHighlights = {}

		for idx, opt in ipairs(list) do
			local optBtn = Instance.new("TextButton")
			optBtn.Size = UDim2.new(1, 0, 0, 32)
			optBtn.BackgroundColor3 = Color3.fromRGB(35, 35, 35)
			optBtn.BackgroundTransparency = 1
			optBtn.Text = opt
			optBtn.TextColor3 = Theme.TextMuted
			optBtn.Font = Theme.Font
			optBtn.TextSize = 13
			optBtn.Parent = listScroller

			local obc = Instance.new("UICorner")
			obc.CornerRadius = UDim.new(0, 6)
			obc.Parent = optBtn

			local highlight = Instance.new("Frame")
			highlight.Size = UDim2.new(0, 3, 0, 20)
			highlight.Position = UDim2.new(0, 0, 0.5, -10)
			highlight.BackgroundColor3 = Theme.Accent
			highlight.BorderSizePixel = 0
			highlight.BackgroundTransparency = 1
			highlight.Parent = optBtn

			local hoverIn = optBtn.MouseEnter:Connect(function()
				if selectedItem ~= opt then
					Tween(optBtn, 0.15, {BackgroundTransparency = 0.7, BackgroundColor3 = Color3.fromRGB(50, 50, 50)})
					Tween(optBtn, 0.15, {TextColor3 = Theme.TextColor})
				end
			end)
			local hoverOut = optBtn.MouseLeave:Connect(function()
				if selectedItem ~= opt then
					Tween(optBtn, 0.15, {BackgroundTransparency = 1})
					Tween(optBtn, 0.15, {TextColor3 = Theme.TextMuted})
				end
			end)
			compJanitor:Add(hoverIn)
			compJanitor:Add(hoverOut)

			local clickConn = optBtn.MouseButton1Click:Connect(function()
				if selectedItem and itemHighlights[selectedItem] then
					Tween(selectedItem, 0.15, {BackgroundTransparency = 1, BackgroundColor3 = Color3.fromRGB(35, 35, 35)})
					Tween(selectedItem, 0.15, {TextColor3 = Theme.TextMuted})
					Tween(itemHighlights[selectedItem], 0.15, {BackgroundTransparency = 1})
				end
				selectedItem = optBtn
				itemHighlights[optBtn] = highlight
				Tween(optBtn, 0.2, {BackgroundTransparency = 0.6, BackgroundColor3 = Theme.Accent})
				Tween(optBtn, 0.2, {TextColor3 = Theme.TextColor})
				Tween(highlight, 0.2, {BackgroundTransparency = 0})
				mainBtn.Text = "  " .. dropText .. " (" .. opt .. ")"
				callback(opt)
				isOpened = false
				_CloseDropdown(dropFrame, listScroller, arrow)
			end)
			compJanitor:Add(clickConn)

			table.insert(itemFrames, optBtn)
		end

		local closeOverlay = Instance.new("TextButton")
		closeOverlay.Size = UDim2.new(1, 0, 1, 0)
		closeOverlay.BackgroundTransparency = 1
		closeOverlay.Text = ""
		closeOverlay.Visible = false
		closeOverlay.ZIndex = 5
		closeOverlay.Parent = dropFrame

		local overlayClick = closeOverlay.MouseButton1Click:Connect(function()
			if isOpened then
				isOpened = false
				_CloseDropdown(dropFrame, listScroller, arrow)
			end
		end)
		compJanitor:Add(overlayClick)

		local function _OpenDropdown(dropFrame, listScroller, arrow, itemCount)
			local maxListHeight = math.min(itemCount * 36 + 8, 200)
			local totalHeight = 44 + maxListHeight
			listScroller.Visible = true
			listScroller.CanvasSize = UDim2.new(0, 0, 0, itemCount * 36)
			closeOverlay.Visible = true
			Tween(dropFrame, 0.25, {Size = UDim2.new(1, 0, 0, totalHeight)}, Enum.EasingStyle.Quart)
			Tween(arrow, 0.25, {Rotation = 180}, Enum.EasingStyle.Quart)
			task.delay(0.05, function()
				if not listScroller.Parent then return end
				for _, child in ipairs(listScroller:GetChildren()) do
					if child:IsA("TextButton") then
						child.BackgroundTransparency = 1
						Tween(child, 0.2, {BackgroundTransparency = 0.7, BackgroundColor3 = Color3.fromRGB(35, 35, 35)})
					end
				end
			end)
		end

		local function _CloseDropdown(dropFrame, listScroller, arrow)
			Tween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 44)}, Enum.EasingStyle.Quart)
			Tween(arrow, 0.2, {Rotation = 0}, Enum.EasingStyle.Quart)
			closeOverlay.Visible = false
			listScroller.Visible = false
		end

		local function toggleDropdown()
			isOpened = not isOpened
			if isOpened then
				_OpenDropdown(dropFrame, listScroller, arrow, #list)
			else
				_CloseDropdown(dropFrame, listScroller, arrow)
			end
		end

		local mainClick = mainBtn.MouseButton1Click:Connect(toggleDropdown)
		compJanitor:Add(mainClick)

		return {
			Destroy = function() compJanitor:Destroy() end,
			GetValue = function() return selectedItem and selectedItem.Text or nil end,
			SetValue = function(value)
				for _, itemBtn in ipairs(itemFrames) do
					if itemBtn.Text == value then
						if selectedItem and itemHighlights[selectedItem] then
							Tween(selectedItem, 0.15, {BackgroundTransparency = 1, BackgroundColor3 = Color3.fromRGB(35, 35, 35)})
							Tween(selectedItem, 0.15, {TextColor3 = Theme.TextMuted})
							Tween(itemHighlights[selectedItem], 0.15, {BackgroundTransparency = 1})
						end
						selectedItem = itemBtn
						local hl = itemBtn:FindFirstChildOfClass("Frame")
						if hl then itemHighlights[itemBtn] = hl end
						Tween(itemBtn, 0.2, {BackgroundTransparency = 0.6, BackgroundColor3 = Theme.Accent})
						Tween(itemBtn, 0.2, {TextColor3 = Theme.TextColor})
						mainBtn.Text = "  " .. dropText .. " (" .. value .. ")"
						callback(value)
						break
					end
				end
			end,
		}
	end

	-- TEXTBOX
	function elements:CreateTextBox(placeholder, callback)
		callback = callback or function() end
		local compJanitor = Janitor.new()

		local boxFrame = Instance.new("Frame")
		boxFrame.Size = UDim2.new(1, 0, 0, 44)
		boxFrame.BackgroundColor3 = Theme.CardBg
		boxFrame.Parent = pageFrame
		compJanitor:Add(boxFrame)

		local bfCorner = Instance.new("UICorner")
		bfCorner.CornerRadius = UDim.new(0, 8)
		bfCorner.Parent = boxFrame

		local stroke = Instance.new("UIStroke")
		stroke.Thickness = 1.5
		stroke.Color = Theme.Stroke
		stroke.Parent = boxFrame

		local statusBar = Instance.new("Frame")
		statusBar.Size = UDim2.new(1, 0, 0, 2)
		statusBar.Position = UDim2.new(0, 0, 1, -2)
		statusBar.BackgroundColor3 = Theme.Stroke
		statusBar.BorderSizePixel = 0
		statusBar.BackgroundTransparency = 1
		statusBar.Parent = boxFrame

		local statusCorner = Instance.new("UICorner")
		statusCorner.CornerRadius = UDim.new(0, 2)
		statusCorner.Parent = statusBar

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1, -24, 1, 0)
		box.Position = UDim2.new(0, 12, 0, 0)
		box.BackgroundTransparency = 1
		box.PlaceholderText = placeholder
		box.PlaceholderColor3 = Theme.TextMuted
		box.Text = ""
		box.TextColor3 = Theme.TextColor
		box.Font = Theme.Font
		box.TextSize = 14
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.ClearTextOnFocus = false
		box.Parent = boxFrame

		local floatingLabel = Instance.new("TextLabel")
		floatingLabel.Size = UDim2.new(0, 100, 0, 16)
		floatingLabel.Position = UDim2.new(0, 12, 0, -18)
		floatingLabel.BackgroundTransparency = 1
		floatingLabel.Text = placeholder
		floatingLabel.TextColor3 = Theme.TextMuted
		floatingLabel.Font = Theme.Font
		floatingLabel.TextSize = 11
		floatingLabel.TextXAlignment = Enum.TextXAlignment.Left
		floatingLabel.Visible = false
		floatingLabel.Parent = boxFrame

		local currentState = "normal"

		local function setState(state)
			currentState = state
			if state == "normal" then
				Tween(stroke, 0.2, {Color = Theme.Stroke, Thickness = 1.5})
				Tween(statusBar, 0.2, {BackgroundTransparency = 1})
				Tween(floatingLabel, 0.15, {TextColor3 = Theme.TextMuted})
			elseif state == "focused" then
				Tween(stroke, 0.25, {Color = Theme.Accent, Thickness = 2})
				Tween(statusBar, 0.25, {BackgroundTransparency = 0, BackgroundColor3 = Theme.Accent})
				Tween(floatingLabel, 0.15, {TextColor3 = Theme.Accent})
				floatingLabel.Visible = true
				Tween(floatingLabel, 0.2, {Position = UDim2.new(0, 12, 0, -18), TextSize = 11})
			elseif state == "success" then
				Tween(stroke, 0.25, {Color = Color3.fromRGB(50, 200, 80), Thickness = 2})
				Tween(statusBar, 0.25, {BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(50, 200, 80)})
			elseif state == "error" then
				Tween(stroke, 0.25, {Color = Color3.fromRGB(255, 80, 80), Thickness = 2})
				Tween(statusBar, 0.25, {BackgroundTransparency = 0, BackgroundColor3 = Color3.fromRGB(255, 80, 80)})
			end
		end

		local focusedConn = box.Focused:Connect(function()
			setState("focused")
		end)
		compJanitor:Add(focusedConn)

		local focusLostConn = box.FocusLost:Connect(function(enterPressed)
			if currentState == "focused" then
				setState("normal")
			end
			if box.Text ~= "" then
				floatingLabel.Visible = true
			else
				Tween(floatingLabel, 0.15, {Position = UDim2.new(0, 12, 0, 0), TextSize = 14})
				task.delay(0.15, function()
					if box.Text == "" then floatingLabel.Visible = false end
				end)
			end
			callback(box.Text, enterPressed)
		end)
		compJanitor:Add(focusLostConn)

		local textChangedConn = box:GetPropertyChangedSignal("Text"):Connect(function()
			if box.Text ~= "" and not floatingLabel.Visible then
				floatingLabel.Visible = true
				Tween(floatingLabel, 0.2, {Position = UDim2.new(0, 12, 0, -18), TextSize = 11})
			elseif box.Text == "" and currentState == "normal" then
				floatingLabel.Visible = false
			end
		end)
		compJanitor:Add(textChangedConn)

		return {
			Destroy = function() compJanitor:Destroy() end,
			GetText = function() return box.Text end,
			SetText = function(text)
				box.Text = text or ""
				if box.Text ~= "" then
					floatingLabel.Visible = true
					Tween(floatingLabel, 0.2, {Position = UDim2.new(0, 12, 0, -18), TextSize = 11})
				end
			end,
			SetState = function(state) setState(state) end,
			SetPlaceholder = function(ph)
				box.PlaceholderText = ph
				floatingLabel.Text = ph
			end,
		}
	end

	return elements
end

