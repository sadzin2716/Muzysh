-- [[ CRIADOR DE PÁGINAS ]]
function Muzysh:CreatePage(pageName)
	local pageId = #self.Pages + 1

	local canvasGroup = Instance.new("CanvasGroup")
	canvasGroup.Name = pageName .. "_Canvas"
	canvasGroup.Size = UDim2.new(1, 0, 1, 0)
	canvasGroup.BackgroundTransparency = 1
	canvasGroup.GroupTransparency = 1
	canvasGroup.Visible = false
	canvasGroup.ZIndex = 3
	canvasGroup.Parent = self.PageContainer

	local pageFrame = Instance.new("ScrollingFrame")
	pageFrame.Name = "Content"
	pageFrame.Size = UDim2.new(1, 0, 1, 0)
	pageFrame.BackgroundTransparency = 1
	pageFrame.ScrollBarThickness = 2
	pageFrame.ScrollBarImageColor3 = Theme.Accent
	pageFrame.ScrollBarImageTransparency = 0.5
	pageFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	pageFrame.ClipsDescendants = false -- Permite que Dropdowns expandidos apareçam livremente
	pageFrame.Parent = canvasGroup

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.Padding = UDim.new(0, 6)
	pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pageLayout.Parent = pageFrame

	self.Janitor:Add(pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		pageFrame.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 15)
	end))

	local pagePadding = Instance.new("UIPadding")
	pagePadding.PaddingRight = UDim.new(0, 4)
	pagePadding.PaddingLeft = UDim.new(0, 4)
	pagePadding.Parent = pageFrame

	-- BOTÃO DA ABA CORRIGIDO E VISÍVEL
	local tabBtn = Instance.new("TextButton")
	tabBtn.Name = pageName .. "_Tab"
	tabBtn.Size = UDim2.new(0, 134, 0, 32)
	tabBtn.BackgroundTransparency = 0.95
	tabBtn.BackgroundColor3 = Theme.TextColor
	tabBtn.Text = "   " .. pageName
	tabBtn.TextColor3 = Theme.TextMuted
	tabBtn.Font = Theme.Font
	tabBtn.TextSize = 12
	tabBtn.TextXAlignment = Enum.TextXAlignment.Left
	tabBtn.ZIndex = 5
	tabBtn.Parent = self.Sidebar

	local tabCorner = Instance.new("UICorner")
	tabCorner.CornerRadius = UDim.new(0, 4)
	tabCorner.Parent = tabBtn

	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 3, 0, 0)
	indicator.AnchorPoint = Vector2.new(0, 0.5)
	indicator.Position = UDim2.new(0, 0, 0.5, 0)
	indicator.BackgroundColor3 = Theme.Accent
	indicator.BorderSizePixel = 0
	indicator.ZIndex = 6
	indicator.Parent = tabBtn

	local function SelectPage()
		for _, p in pairs(self.Pages) do
			if p.Visible then
				CreateTween(p, 0.15, {GroupTransparency = 1})
				p.Visible = false
			end
		end
		for t, ind in pairs(self.Tabs) do 
			CreateTween(t, 0.15, {TextColor3 = Theme.TextMuted, BackgroundTransparency = 0.95})
			CreateTween(ind, 0.15, {Size = UDim2.new(0, 3, 0, 0)})
		end

		canvasGroup.Visible = true
		CreateTween(canvasGroup, 0.2, {GroupTransparency = 0})
		CreateTween(tabBtn, 0.15, {TextColor3 = Theme.TextColor, BackgroundTransparency = 0.85})
		CreateTween(indicator, 0.2, {Size = UDim2.new(0, 3, 0, 14)})
	end

	self.Janitor:Add(tabBtn.MouseButton1Click:Connect(SelectPage))
	self.Pages[pageId] = canvasGroup
	self.Tabs[tabBtn] = indicator

	if not self.FirstPage then
		self.FirstPage = SelectPage
		task.spawn(SelectPage)
	end

	local elements = {}

	-- [[ COMPONENTE: SEÇÃO ]]
	function elements:CreateSection(titleText)
		local sectionFrame = Instance.new("Frame")
		sectionFrame.Size = UDim2.new(1, 0, 0, 24)
		sectionFrame.BackgroundTransparency = 1
		sectionFrame.Parent = pageFrame

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(1, 0, 1, 0)
		label.Text = titleText:upper()
		label.Font = Theme.FontMono
		label.TextSize = 10
		label.TextColor3 = Theme.Accent
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.BackgroundTransparency = 1
		label.Parent = sectionFrame
	end

	-- [[ COMPONENTE: TOGGLE (CORRIGIDO) ]]
	function elements:CreateToggle(toggleText, default, callback)
		callback = callback or function() end
		local state = default or false

		local toggleFrame = Instance.new("Frame")
		toggleFrame.Size = UDim2.new(1, 0, 0, 38)
		toggleFrame.BackgroundColor3 = Theme.CardBg
		toggleFrame.ZIndex = 4
		toggleFrame.Parent = pageFrame

		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(0, 5)
		tc.Parent = toggleFrame

		local ts = Instance.new("UIStroke")
		ts.Color = Theme.Stroke
		ts.Thickness = 1
		ts.Parent = toggleFrame

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0.7, 0, 1, 0)
		label.Position = UDim2.new(0, 10, 0, 0)
		label.BackgroundTransparency = 1
		label.Text = toggleText
		label.TextColor3 = Theme.TextColor
		label.Font = Theme.Font
		label.TextSize = 12
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = toggleFrame

		local switch = Instance.new("TextButton")
		switch.Size = UDim2.new(0, 34, 0, 18)
		switch.Position = UDim2.new(1, -44, 0.5, -9)
		switch.BackgroundColor3 = Color3.fromRGB(40, 40, 48)
		switch.Text = ""
		switch.Parent = toggleFrame

		local sc = Instance.new("UICorner")
		sc.CornerRadius = UDim.new(1, 0)
		sc.Parent = switch

		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 12, 0, 12)
		knob.AnchorPoint = Vector2.new(0, 0.5)
		knob.Position = state and UDim2.new(1, -15, 0.5, 0) or UDim2.new(0, 3, 0.5, 0)
		knob.BackgroundColor3 = Theme.TextColor
		knob.Parent = switch

		local kc = Instance.new("UICorner")
		kc.CornerRadius = UDim.new(1, 0)
		kc.Parent = knob

		if state then 
			switch.BackgroundColor3 = Theme.Accent 
		end

		switch.MouseButton1Click:Connect(function()
			state = not state
			if state then
				CreateTween(switch, 0.15, {BackgroundColor3 = Theme.Accent})
				CreateTween(knob, 0.15, {Position = UDim2.new(1, -15, 0.5, 0)})
			else
				CreateTween(switch, 0.15, {BackgroundColor3 = Color3.fromRGB(40, 40, 48)})
				CreateTween(knob, 0.15, {Position = UDim2.new(0, 3, 0.5, 0)})
			end
			callback(state)
		end)
	end

	-- [[ COMPONENTE: SLIDER ]]
	function elements:CreateSlider(sliderText, min, max, default, callback)
		callback = callback or function() end
		local value = default or min

		local sliderFrame = Instance.new("Frame")
		sliderFrame.Size = UDim2.new(1, 0, 0, 46)
		sliderFrame.BackgroundColor3 = Theme.CardBg
		sliderFrame.Parent = pageFrame

		local slc = Instance.new("UICorner")
		slc.CornerRadius = UDim.new(0, 5)
		slc.Parent = sliderFrame

		local sls = Instance.new("UIStroke")
		sls.Color = Theme.Stroke
		sls.Thickness = 1
		sls.Parent = sliderFrame

		local label = Instance.new("TextLabel")
		label.Size = UDim2.new(0.6, 0, 0, 20)
		label.Position = UDim2.new(0, 10, 0, 4)
		label.BackgroundTransparency = 1
		label.Text = sliderText
		label.TextColor3 = Theme.TextColor
		label.Font = Theme.Font
		label.TextSize = 12
		label.TextXAlignment = Enum.TextXAlignment.Left
		label.Parent = sliderFrame

		local valLabel = Instance.new("TextLabel")
		valLabel.Size = UDim2.new(0.3, 0, 0, 20)
		valLabel.Position = UDim2.new(1, -10 + -90, 0, 4)
		valLabel.BackgroundTransparency = 1
		valLabel.Text = tostring(value)
		valLabel.TextColor3 = Theme.Accent
		valLabel.Font = Theme.FontMono
		valLabel.TextSize = 12
		valLabel.TextXAlignment = Enum.TextXAlignment.Right
		valLabel.Parent = sliderFrame

		local track = Instance.new("TextButton")
		track.Size = UDim2.new(1, -20, 0, 4)
		track.Position = UDim2.new(0, 10, 0, 32)
		track.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
		track.Text = ""
		track.Parent = sliderFrame

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
		fill.BackgroundColor3 = Theme.Accent
		fill.BorderSizePixel = 0
		fill.Parent = track

		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 10, 0, 10)
		knob.AnchorPoint = Vector2.new(0.5, 0.5)
		knob.Position = UDim2.new((value - min) / (max - min), 0, 0.5, 0)
		knob.BackgroundColor3 = Theme.TextColor
		knob.Parent = track

		local kc = Instance.new("UICorner")
		kc.CornerRadius = UDim.new(1, 0)
		kc.Parent = knob

		local sliding = false

		local function UpdateSlider(input)
			local percentage = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteWidth, 0, 1)
			value = math.floor(min + (max - min) * percentage)
			valLabel.Text = tostring(value)
			fill.Size = UDim2.new(percentage, 0, 1, 0)
			knob.Position = UDim2.new(percentage, 0, 0.5, 0)
			callback(value)
		end

		track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				UpdateSlider(input)
			end
		end)

		UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				UpdateSlider(input)
			end
		end)

		UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
			end
		end)
	end

	-- [[ COMPONENTE: DROPDOWN (CORRIGIDO GLOBALMENTE) ]]
	function elements:CreateDropdown(dropText, list, callback)
		callback = callback or function() end
		local isOpened = false

		local dropFrame = Instance.new("Frame")
		dropFrame.Size = UDim2.new(1, 0, 0, 38)
		dropFrame.BackgroundColor3 = Theme.CardBg
		dropFrame.ClipsDescendants = true
		dropFrame.ZIndex = 100 -- Elevação forçada sobre os outros elementos
		dropFrame.Parent = pageFrame

		local dc = Instance.new("UICorner")
		dc.CornerRadius = UDim.new(0, 5)
		dc.Parent = dropFrame

		local ds = Instance.new("UIStroke")
		ds.Color = Theme.Stroke
		ds.Thickness = 1
		ds.Parent = dropFrame

		local mainBtn = Instance.new("TextButton")
		mainBtn.Size = UDim2.new(1, 0, 0, 38)
		mainBtn.BackgroundTransparency = 1
		mainBtn.Text = "   " .. dropText
		mainBtn.TextColor3 = Theme.TextColor
		mainBtn.Font = Theme.Font
		mainBtn.TextSize = 12
		mainBtn.TextXAlignment = Enum.TextXAlignment.Left
		mainBtn.Parent = dropFrame

		local arrow = Instance.new("TextLabel")
		arrow.Size = UDim2.new(0, 38, 0, 38)
		arrow.Position = UDim2.new(1, -38, 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.Text = "▼"
		arrow.TextColor3 = Theme.TextMuted
		arrow.Font = Theme.Font
		arrow.TextSize = 9
		arrow.Parent = mainBtn

		local listHolder = Instance.new("Frame")
		listHolder.Size = UDim2.new(1, -16, 1, -42)
		listHolder.Position = UDim2.new(0, 8, 0, 40)
		listHolder.BackgroundTransparency = 1
		listHolder.Parent = dropFrame

		local listLayout = Instance.new("UIListLayout")
		listLayout.Padding = UDim.new(0, 4)
		listLayout.Parent = listHolder

		for _, opt in pairs(list) do
			local optBtn = Instance.new("TextButton")
			optBtn.Size = UDim2.new(1, 0, 0, 28)
			optBtn.BackgroundColor3 = Color3.fromRGB(34, 34, 42)
			optBtn.Text = opt
			optBtn.TextColor3 = Theme.TextMuted
			optBtn.Font = Theme.Font
			optBtn.TextSize = 11
			optBtn.Parent = listHolder

			local oc = Instance.new("UICorner")
			oc.CornerRadius = UDim.new(0, 4)
			oc.Parent = optBtn

			optBtn.MouseButton1Click:Connect(function()
				mainBtn.Text = "   " .. dropText .. " (" .. opt .. ")"
				isOpened = false
				CreateTween(dropFrame, 0.15, {Size = UDim2.new(1, 0, 0, 38)})
				CreateTween(arrow, 0.15, {Rotation = 0})
				callback(opt)
			end)
		end

		mainBtn.MouseButton1Click:Connect(function()
			isOpened = not isOpened
			if isOpened then
				local neededHeight = 42 + (#list * 32)
				CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, neededHeight)})
				CreateTween(arrow, 0.2, {Rotation = 180})
			else
				CreateTween(dropFrame, 0.15, {Size = UDim2.new(1, 0, 0, 38)})
				CreateTween(arrow, 0.15, {Rotation = 0})
			end
		end)
	end

	return elements
end

function Muzysh:Destroy()
	if self.Janitor then self.Janitor:Clean() end
	if self.ScreenGui then self.ScreenGui:Destroy() end
end

return Muzysh
