-- [[ CRIADOR DE PÁGINAS COM SUPORTE A CANVASGROUP ]]
function Muzysh:CreatePage(pageName)
	local pageId = #self.Pages + 1

	local canvasGroup = Instance.new("CanvasGroup")
	canvasGroup.Name = pageName .. "_Canvas"
	canvasGroup.Size = UDim2.new(1, 0, 1, 0)
	canvasGroup.BackgroundTransparency = 1
	canvasGroup.GroupTransparency = 1
	canvasGroup.Visible = false
	canvasGroup.Parent = self.PageContainer

	local pageFrame = Instance.new("ScrollingFrame")
	pageFrame.Name = "Content"
	pageFrame.Size = UDim2.new(1, 0, 1, 0)
	pageFrame.BackgroundTransparency = 1
	pageFrame.ScrollBarThickness = 3
	pageFrame.ScrollBarImageColor3 = Theme.Accent
	pageFrame.ScrollBarImageTransparency = 0.4
	pageFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	pageFrame.Parent = canvasGroup

	local pageLayout = Instance.new("UIListLayout")
	pageLayout.Padding = UDim.new(0, 7)
	pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
	pageLayout.Parent = pageFrame

	self.Janitor:Add(pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		pageFrame.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 10)
	end))

	local pagePadding = Instance.new("UIPadding")
	pagePadding.PaddingRight = UDim.new(0, 6)
	pagePadding.PaddingLeft = UDim.new(0, 2)
	pagePadding.Parent = pageFrame

	-- Botão Ergonomico da Sidebar (Tamanho Otimizado Mobile)
	local tabBtn = Instance.new("TextButton")
	tabBtn.Name = pageName .. "_Tab"
	tabBtn.Size = UDim2.new(0, 124, 0, 36)
	tabBtn.BackgroundTransparency = 1
	tabBtn.Text = "   " .. pageName
	tabBtn.TextColor3 = Theme.TextMuted
	tabBtn.Font = Theme.Font
	tabBtn.TextSize = 13
	tabBtn.TextXAlignment = Enum.TextXAlignment.Left
	tabBtn.Parent = self.Sidebar

	local tabCorner = Instance.new("UICorner")
	tabCorner.CornerRadius = UDim.new(0, 6)
	tabCorner.Parent = tabBtn

	local indicator = Instance.new("Frame")
	indicator.Size = UDim2.new(0, 3, 0, 0)
	indicator.Position = UDim2.new(0, 0, 0.5, 0)
	indicator.BackgroundColor3 = Theme.Accent
	indicator.BorderSizePixel = 0
	indicator.Parent = tabBtn

	local function SelectPage()
		for _, p in pairs(self.Pages) do
			if p.Visible then
				CreateTween(p, 0.2, {GroupTransparency = 1, Position = UDim2.new(0, -15, 0, 0)})
				task.delay(0.2, function() p.Visible = false end)
			end
		end
		for t, ind in pairs(self.Tabs) do 
			CreateTween(t, 0.2, {TextColor3 = Theme.TextMuted, BackgroundColor3 = Theme.Sidebar})
			CreateTween(ind, 0.2, {Size = UDim2.new(0, 3, 0, 0), Position = UDim2.new(0, 0, 0.5, 0)})
		end

		canvasGroup.Visible = true
		canvasGroup.Position = UDim2.new(0, 15, 0, 0)
		CreateTween(canvasGroup, 0.25, {GroupTransparency = 0, Position = UDim2.new(0, 0, 0, 0)})
		CreateTween(tabBtn, 0.2, {TextColor3 = Theme.TextColor, BackgroundColor3 = Theme.CardBg})
		CreateTween(indicator, 0.25, {Size = UDim2.new(0, 3, 0, 16), Position = UDim2.new(0, 0, 0.28, 0)})
	end

	self.Janitor:Add(tabBtn.MouseButton1Click:Connect(SelectPage))
	self.Pages[pageId] = canvasGroup
	self.Tabs[tabBtn] = indicator

	if not self.FirstPage then
		self.FirstPage = SelectPage
		task.spawn(SelectPage)
	end

	local elements = {}

