        fill.BorderSizePixel = 0
        fill.Parent = trackContainer

        local fillCorner = Instance.new("UICorner")
        fillCorner.CornerRadius = UDim.new(1, 0)
        fillCorner.Parent = fill

        local snap = Instance.new("Frame")
        snap.Size = UDim2.new(0, 12, 0, 12)
        snap.Position = UDim2.new((value - min) / (max - min), -6, 0.5, -6)
        snap.BackgroundColor3 = windowSelf.Theme.TextColor
        snap.Parent = trackContainer

        local snCorner = Instance.new("UICorner")
        snCorner.CornerRadius = UDim.new(1, 0)
        snCorner.Parent = snap

        local snapStroke = Instance.new("UIStroke")
        snapStroke.Color = windowSelf.Theme.Stroke
        snapStroke.Thickness = 1
        snapStroke.Parent = snap

        local trackBtn = Instance.new("TextButton")
        trackBtn.Size = UDim2.new(1, 0, 1, 0)
        trackBtn.BackgroundTransparency = 1
        trackBtn.Text = ""
        trackBtn.Parent = trackContainer

        local sliding = false

        local function updateFromPosition(inputPosition)
            local percent = math.clamp((inputPosition.X - trackContainer.AbsolutePosition.X) / trackContainer.AbsoluteSize.X, 0, 1)
            local rawValue = min + ((max - min) * percent)
            
            if isDecimal then value = math.round(rawValue * 10) / 10 else value = math.floor(rawValue) end
            
            valLabel.Text = tostring(value)
            CreateTween(fill, 0.08, {Size = UDim2.new(percent, 0, 1, 0)})
            CreateTween(snap, 0.08, {Position = UDim2.new(percent, -6, 0.5, -6)})
            
            if flag then
                windowSelf.Flags[flag] = value
                windowSelf:SaveConfig()
            end
            callback(value)
        end

        trackBtn.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                sliding = true
                pageFrame.ScrollingEnabled = false
                updateFromPosition(input.Position)
            end
        end)

        trackBtn.InputChanged:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
                updateFromPosition(input.Position)
            end
        end)

        local endConn
        endConn = UserInputService.InputEnded:Connect(function(input)
            if sliding and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
                sliding = false
                pageFrame.ScrollingEnabled = true
            end
        end)
        trackContainer.Destroying:Connect(function() 
            if endConn then endConn:Disconnect() end
            pageFrame.ScrollingEnabled = true 
        end)
        
        if flag and windowSelf.SavedFlags[flag] ~= nil then task.spawn(callback, value) end
    end

    function elements:CreateDropdown(dropText, list, flag, callback)
        callback = callback or function() end
        local isOpened = false
        local selected = list[1] or ""
        
        if flag and windowSelf.SavedFlags[flag] ~= nil then selected = windowSelf.SavedFlags[flag] end
        if flag then windowSelf.Flags[flag] = selected end

        local dropFrame = CreateCardFrame()
        dropFrame.Size = UDim2.new(1, 0, 0, 38)
        dropFrame.ClipsDescendants = true
        dropFrame.Parent = pageFrame

        local mainBtn = Instance.new("TextButton")
        mainBtn.Size = UDim2.new(1, 0, 0, 38)
        mainBtn.BackgroundTransparency = 1
        mainBtn.Text = "  " .. dropText .. (selected ~= "" and " (" .. selected .. ")" or "")
        mainBtn.TextColor3 = windowSelf.Theme.TextColor
        mainBtn.Font = windowSelf.Theme.Font
        mainBtn.TextSize = 13
        mainBtn.TextXAlignment = Enum.TextXAlignment.Left
        mainBtn.Parent = dropFrame

        local arrow = Instance.new("TextLabel")
        arrow.Size = UDim2.new(0, 38, 0, 38)
        arrow.Position = UDim2.new(1, -38, 0, 0)
        arrow.BackgroundTransparency = 1
        arrow.Text = "▼"
        arrow.TextColor3 = windowSelf.Theme.TextMuted
        arrow.Font = windowSelf.Theme.Font
        arrow.TextSize = 10
        arrow.Parent = mainBtn

        local listHolder = Instance.new("ScrollingFrame")
        listHolder.Size = UDim2.new(1, -16, 1, -42)
        listHolder.Position = UDim2.new(0, 8, 0, 40)
        listHolder.BackgroundTransparency = 1
        listHolder.ScrollBarThickness = 2
        listHolder.ScrollBarImageColor3 = windowSelf.Theme.Stroke
        listHolder.CanvasSize = UDim2.new(0, 0, 0, 0)
        listHolder.Parent = dropFrame

        local listLayout = Instance.new("UIListLayout")
        listLayout.Padding = UDim.new(0, 3)
        listLayout.Parent = listHolder

        listLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
            listHolder.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y)
        end)

        for _, opt in ipairs(list) do
            local optBtn = Instance.new("TextButton")
            optBtn.Size = UDim2.new(1, 0, 0, 28)
            optBtn.BackgroundColor3 = Color3.fromRGB(46, 46, 46)
            optBtn.Text = "  " .. opt
            optBtn.TextColor3 = windowSelf.Theme.TextMuted
            optBtn.Font = windowSelf.Theme.Font
            optBtn.TextSize = 12
            optBtn.TextXAlignment = Enum.TextXAlignment.Left
            optBtn.Parent = listHolder

            local obc = Instance.new("UICorner")
            obc.CornerRadius = UDim.new(0, 4)
            obc.Parent = optBtn

            optBtn.MouseEnter:Connect(function() CreateTween(optBtn, 0.1, {TextColor3 = windowSelf.Theme.TextColor, BackgroundColor3 = Color3.fromRGB(55, 55, 55)}) end)
            optBtn.MouseLeave:Connect(function() CreateTween(optBtn, 0.1, {TextColor3 = windowSelf.Theme.TextMuted, BackgroundColor3 = Color3.fromRGB(46, 46, 46)}) end)

            optBtn.MouseButton1Click:Connect(function()
                selected = opt
                mainBtn.Text = "  " .. dropText .. " (" .. opt .. ")"
                isOpened = false
                CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 38)})
                CreateTween(arrow, 0.2, {Rotation = 0})
                
                if flag then
                    windowSelf.Flags[flag] = selected
                    windowSelf:SaveConfig()
                end
                callback(opt)
            end)
        end

        mainBtn.MouseButton1Click:Connect(function()
            isOpened = not isOpened
            if isOpened then
                local contentHeight = 42 + (#list * 31)
                local finalHeight = math.clamp(contentHeight, 38, 140)
                CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, finalHeight)})
                CreateTween(arrow, 0.2, {Rotation = 180})
            else
                CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 38)})
                CreateTween(arrow, 0.2, {Rotation = 0})
            end
        end)
        
        if flag and windowSelf.SavedFlags[flag] ~= nil then task.spawn(callback, selected) end
    end

    function elements:CreateTextBox(placeholder, flag, callback)
        callback = callback or function() end
        local currentText = ""
        
        if flag and windowSelf.SavedFlags[flag] ~= nil then currentText = windowSelf.SavedFlags[flag] end
        if flag then windowSelf.Flags[flag] = currentText end

        local boxFrame = CreateCardFrame()
        boxFrame.Size = UDim2.new(1, 0, 0, 38)
        boxFrame.Parent = pageFrame

        local stroke = boxFrame:FindFirstChildOfClass("UIStroke")

        local box = Instance.new("TextBox")
        box.Size = UDim2.new(1, -24, 1, 0)
        box.Position = UDim2.new(0, 12, 0, 0)
        box.BackgroundTransparency = 1
        box.PlaceholderText = placeholder
        box.PlaceholderColor3 = windowSelf.Theme.TextMuted
        box.Text = currentText
        box.TextColor3 = windowSelf.Theme.TextColor
        box.Font = windowSelf.Theme.Font
        box.TextSize = 13
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.Parent = boxFrame

        box.Focused:Connect(function() if stroke then CreateTween(stroke, 0.15, {Color = windowSelf.Theme.Accent}) end end)
        box.FocusLost:Connect(function(enterPressed)
            if stroke then CreateTween(stroke, 0.15, {Color = windowSelf.Theme.Stroke}) end
            currentText = box.Text
            if flag then
                windowSelf.Flags[flag] = currentText
                windowSelf:SaveConfig()
            end
            callback(currentText, enterPressed)
        end)
        
        if flag and windowSelf.SavedFlags[flag] ~= nil and currentText ~= "" then
            task.spawn(callback, currentText, false)
        end
    end

    return elements
end

return Muzysh
