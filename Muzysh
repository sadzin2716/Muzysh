function ThemeManager.new(initialTheme)
	local self = setmetatable({
		_currentTheme = nil,
		_listeners = {},
		_animManager = nil,
	}, ThemeManager)
	local theme = initialTheme or ThemeManager.BuiltInThemes.DarkRed
	self:SetTheme(theme)
	return self
end

function ThemeManager:SetAnimationManager(animManager)
	self._animManager = animManager
end

function ThemeManager:OnThemeChanged(callback)
	table.insert(self._listeners, callback)
	callback(self._currentTheme)
end

function ThemeManager:SetTheme(theme)
	if type(theme) == "string" then
		theme = ThemeManager.BuiltInThemes[theme]
		if not theme then
			warn("ThemeManager: Tema '" .. tostring(theme) .. "' nao encontrado. Usando DarkRed.")
			theme = ThemeManager.BuiltInThemes.DarkRed
		end
	end
	if not theme then return end
	self._currentTheme = theme
	for _, listener in ipairs(self._listeners) do
		task.spawn(listener, theme)
	end
end

function ThemeManager:GetTheme()
	return self._currentTheme
end

function ThemeManager:GetThemeCopy()
	local copy = {}
	for k, v in pairs(self._currentTheme) do
		copy[k] = v
	end
	return copy
end

