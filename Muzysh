		track.BackgroundColor3 = Color3.fromRGB(45, 45, 45)
		track.Parent = trackHitbox

		local trCorner = Instance.new("UICorner")
		trCorner.CornerRadius = UDim.new(1, 0)
		trCorner.Parent = track

		local fill = Instance.new("Frame")
		local initialPercent = (value - min) / (max - min)
		fill.Size = UDim2.new(initialPercent, 0, 1, 0)
		fill.BackgroundColor3 = Theme.Accent
		fill.BorderSizePixel = 0
		fill.Parent = track

		local fillCorner = Instance.new("UICorner")
		fillCorner.CornerRadius = UDim.new(1, 0)
		fillCorner.Parent = fill

		local snap = Instance.new("Frame")
		snap.Size = UDim2.new(0, 22, 0, 22)
		snap.Position = UDim2.new(initialPercent, -11, 0.5, -11)
		snap.BackgroundColor3 = Theme.TextColor
		snap.BorderSizePixel = 0
		snap.Parent = track

		local snCorner = Instance.new("UICorner")
		snCorner.CornerRadius = UDim.new(1, 0)
		snCorner.Parent = snap

		local snapShadow = Instance.new("Frame")
		snapShadow.Size = UDim2.new(1, 4, 1, 4)
		snapShadow.Position = UDim2.new(0.5, -13, 0.5, -13)
		snapShadow.AnchorPoint = Vector2.new(0.5, 0.5)
		snapShadow.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
		snapShadow.BackgroundTransparency = 0.6
		snapShadow.BorderSizePixel = 0
		snapShadow.ZIndex = -1
		snapShadow.Parent = snap

		local snShadowCorner = Instance.new("UICorner")
		snShadowCorner.CornerRadius = UDim.new(1, 0)
		snShadowCorner.Parent = snapShadow

		local tooltip = Instance.new("TextLabel")
		tooltip.Size = UDim2.new(0, 60, 0, 24)
		tooltip.Position = UDim2.new(0, -30, 0, -30)
		tooltip.AnchorPoint = Vector2.new(0.5, 0.5)
		tooltip.BackgroundColor3 = Theme.Accent
		tooltip.Text = tostring(value)
		tooltip.TextColor3 = Theme.TextColor
		tooltip.Font = Theme.FontBold
		tooltip.TextSize = 13
		tooltip.Visible = false
		tooltip.ZIndex = 10
		tooltip.Parent = snap

		local ttCorner = Instance.new("UICorner")
		ttCorner.CornerRadius = UDim.new(0, 6)
		ttCorner.Parent = tooltip

		local sliding = false
		local moveConn = nil
		local endConn = nil

		local function updateKnobPosition(percent)
			fill.Size = UDim2.new(percent, 0, 1, 0)
			snap.Position = UDim2.new(percent, -11, 0.5, -11)
			tooltip.Position = UDim2.new(0, -30, 0, -30)
		end

		local function updateValue(percent)
			value = math.floor(min + (max - min) * percent)
			valLabel.Text = tostring(value)
			tooltip.Text = tostring(value)
			Tween(valLabel, 0.15, {Size = UDim2.new(0, 56, 0, 22)}, Enum.EasingStyle.Back)
			task.delay(0.15, function()
				if valLabel then
					Tween(valLabel, 0.15, {Size = UDim2.new(0, 50, 0, 20)}, Enum.EasingStyle.Back)
				end
			end)
			callback(value)
		end

		local function updateFromInput(input)
			local trackAbsolute = track.AbsolutePosition
			local trackWidth = track.AbsoluteSize.X
			local relativeX = math.clamp((input.Position.X - trackAbsolute.X) / trackWidth, 0, 1)
			updateKnobPosition(relativeX)
			updateValue(relativeX)
		end

		local function startDrag(input)
			sliding = true
			tooltip.Visible = true
			updateFromInput(input)
			moveConn = UserInputService.InputChanged:Connect(function(inputObj)
				if inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch then
					updateFromInput(inputObj)
				end
			end)
			compJanitor:Add(moveConn)
			endConn = UserInputService.InputEnded:Connect(function(inputObj)
				if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
					stopDrag()
				end
			end)
			compJanitor:Add(endConn)
		end

		local function stopDrag()
			sliding = false
			tooltip.Visible = false
			if moveConn then
				moveConn:Disconnect()
				compJanitor:Remove(moveConn)
				moveConn = nil
			end
			if endConn then
				endConn:Disconnect()
				compJanitor:Remove(endConn)
				endConn = nil
			end
			Tween(snap, 0.15, {Size = UDim2.new(0, 22, 0, 22)}, Enum.EasingStyle.Back)
		end

		local beganConn = trackHitbox.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				startDrag(input)
				Tween(snap, 0.1, {Size = UDim2.new(0, 26, 0, 26)}, Enum.EasingStyle.Quad)
			end
		end)
		compJanitor:Add(beganConn)

		local scrollConn = trackHitbox.MouseWheelForward:Connect(function()
			local newValue = math.clamp(value + 1, min, max)
			value = newValue
			local percent = (value - min) / (max - min)
			updateKnobPosition(percent)
			valLabel.Text = tostring(value)
			callback(value)
		end)
		compJanitor:Add(scrollConn)

		local scrollBackConn = trackHitbox.MouseWheelBackward:Connect(function()
			local newValue = math.clamp(value - 1, min, max)
			value = newValue
			local percent = (value - min) / (max - min)
			updateKnobPosition(percent)
			valLabel.Text = tostring(value)
			callback(value)
		end)
		compJanitor:Add(scrollBackConn)

		return {
			Destroy = function() stopDrag(); compJanitor:Destroy() end,
			SetValue = function(val)
				value = math.clamp(val, min, max)
				local percent = (value - min) / (max - min)
				updateKnobPosition(percent)
				valLabel.Text = tostring(value)
			end,
			GetValue = function() return value end,
		}
	end

