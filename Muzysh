-- Cancelamento automático de tweens por instância
local _tweens = {}
local function CreateTween(instance, duration, properties)
    if _tweens[instance] then
        _tweens[instance]:Cancel()
    end
    local tweenInfo = TweenInfo.new(duration, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    _tweens[instance] = tween
    tween.Completed:Connect(function()
        if _tweens[instance] == tween then
            _tweens[instance] = nil
        end
    end)
    return tween
end

-- Sistema de arrasto unificado (janela e botão flutuante)
local function MakeDraggable(dragFrame, moveFrame)
    local dragging, startMouse, startPos
    local moveConn, endConn

    local function stopDrag()
        dragging = false
        if moveConn then moveConn:Disconnect(); moveConn = nil end
        if endConn then endConn:Disconnect(); endConn = nil end
    end

    dragFrame.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            startMouse = input.Position
            startPos = moveFrame.Position

            moveConn = UserInputService.InputChanged:Connect(function(inputObj)
                if dragging and (inputObj.UserInputType == Enum.UserInputType.MouseMovement or inputObj.UserInputType == Enum.UserInputType.Touch) then
                    local delta = inputObj.Position - startMouse
                    moveFrame.Position = UDim2.new(
                        startPos.X.Scale, startPos.X.Offset + delta.X,
                        startPos.Y.Scale, startPos.Y.Offset + delta.Y
                    )
                end
            end)

            endConn = UserInputService.InputEnded:Connect(function(inputObj)
                if inputObj.UserInputType == Enum.UserInputType.MouseButton1 or inputObj.UserInputType == Enum.UserInputType.Touch then
                    stopDrag()
                end
            end)
        end
    end)

    dragFrame.Destroying:Connect(stopDrag)
end

-- ======================== MÉTODOS DA JANELA ========================

function Muzysh:DestroyWindow()
    if self._isDestroyed then return end
    self._isDestroyed = true

    -- Limpeza de memória (Garbage Collection)
    for _, connection in pairs(self._connections) do
        if connection then connection:Disconnect() end
    end
    table.clear(self._connections)

    if self._mainTween then
        self._mainTween:Cancel()
        self._mainTween = nil
    end

    self._mainTween = TweenService:Create(
        self.MainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }
    )
    self._mainTween:Play()

    if self.FloatingBtn then
        self.FloatingBtn:Destroy()
        self.FloatingBtn = nil
    end

    task.delay(0.35, function()
        if self.ScreenGui and self.ScreenGui.Parent then
            self.ScreenGui:Destroy()
        end
    end)
end

function Muzysh:MinimizeWindow()
    if self._isMinimized or self._isDestroyed then return end
    self._isMinimized = true

    if self._mainTween then
        self._mainTween:Cancel()
        self._mainTween = nil
    end

    self._mainTween = TweenService:Create(
        self.MainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Quart, Enum.EasingDirection.In),
        { Size = UDim2.new(0, 0, 0, 0), BackgroundTransparency = 1 }
    )
    self._mainTween:Play()
    self._mainTween.Completed:Connect(function()
        if self._isDestroyed then return end
        self.MainFrame.Visible = false
        self._mainTween = nil
    end)

    if not self.FloatingBtn then
        self:CreateFloatingButton()
    else
        self.FloatingBtn.Visible = true
    end
end

function Muzysh:RestoreWindow()
    if not self._isMinimized or self._isDestroyed then return end
    self._isMinimized = false

    if self.FloatingBtn then
        self.FloatingBtn.Visible = false
    end

    if self._mainTween then
        self._mainTween:Cancel()
        self._mainTween = nil
    end

    self.MainFrame.Visible = true
    self.MainFrame.Size = UDim2.new(0, 0, 0, 0)
    self.MainFrame.BackgroundTransparency = 1

    self._mainTween = TweenService:Create(
        self.MainFrame,
        TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.Out),
        { Size = self.OriginalSize, BackgroundTransparency = 0 }
    )
    self._mainTween:Play()
    self._mainTween.Completed:Connect(function()
        self._mainTween = nil
    end)
end

function Muzysh:CreateFloatingButton()
    if self.FloatingBtn or self._isDestroyed then return end

    local floater = Instance.new("ImageButton")
    floater.Name = "MinimizeFloater"
    floater.Size = UDim2.new(0, 56, 0, 56)
    floater.Position = UDim2.new(1, -72, 1, -72)
    floater.BackgroundColor3 = self.Theme.CardBg
    floater.BackgroundTransparency = 0.3
    floater.Image = "rbxassetid://72939763737478"
    floater.ScaleType = Enum.ScaleType.Fit
    floater.ImageTransparency = 0.1
    floater.AutoButtonColor = false
    floater.Parent = self.ScreenGui

    local floaterCorner = Instance.new("UICorner")
    floaterCorner.CornerRadius = UDim.new(1, 0)
    floaterCorner.Parent = floater

    floater.MouseEnter:Connect(function()
        CreateTween(floater, 0.2, {BackgroundTransparency = 0.1})
    end)
    floater.MouseLeave:Connect(function()
        CreateTween(floater, 0.2, {BackgroundTransparency = 0.3})
    end)

    MakeDraggable(floater, floater)

    floater.MouseButton1Click:Connect(function()
        self:RestoreWindow()
    end)

    self.FloatingBtn = floater
end

