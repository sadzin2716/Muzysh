function Muzysh:CreatePage(pageName, iconId)
    local pageFrame = Instance.new("ScrollingFrame")
    pageFrame.Size = UDim2.new(1, 0, 1, 0)
    pageFrame.BackgroundTransparency = 1
    pageFrame.ScrollBarThickness = 2
    pageFrame.ScrollBarImageColor3 = self.Theme.Stroke
    pageFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
    pageFrame.Visible = false
    pageFrame.Parent = self.PageContainer

    local pageLayout = Instance.new("UIListLayout")
    pageLayout.Padding = UDim.new(0, 6)
    pageLayout.SortOrder = Enum.SortOrder.LayoutOrder
    pageLayout.Parent = pageFrame

    pageLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
        pageFrame.CanvasSize = UDim2.new(0, 0, 0, pageLayout.AbsoluteContentSize.Y + 10)
    end)

    local pagePadding = Instance.new("UIPadding")
    pagePadding.PaddingRight = UDim.new(0, 6)
    pagePadding.Parent = pageFrame

    -- Botão da Aba Lateral (Perfeitamente espaçado e alinhado)
    local tabBtn = Instance.new("TextButton")
    tabBtn.Size = UDim2.new(1, -16, 0, 32)
    tabBtn.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
    tabBtn.BackgroundTransparency = 1
    tabBtn.Text = iconId and "          " .. pageName or "  " .. pageName
    tabBtn.TextColor3 = self.Theme.TextMuted
    tabBtn.Font = self.Theme.Font
    tabBtn.TextSize = 12
    tabBtn.TextXAlignment = Enum.TextXAlignment.Left
    tabBtn.Parent = self.Sidebar:FindFirstChildOfClass("ScrollingFrame")

    local tabCorner = Instance.new("UICorner") tabCorner.CornerRadius = UDim.new(0, 5) tabCorner.Parent = tabBtn

    if iconId then
        local iconLabel = Instance.new("ImageLabel")
        iconLabel.Size = UDim2.new(0, 16, 0, 16)
        iconLabel.Position = UDim2.new(0, 10, 0.5, -8)
        iconLabel.BackgroundTransparency = 1
        iconLabel.Image = typeof(iconId) == "number" and "rbxassetid://" .. iconId or iconId
        iconLabel.ImageColor3 = self.Theme.TextMuted
        iconLabel.ScaleType = Enum.ScaleType.Fit
        iconLabel.Parent = tabBtn
    end

    local function SelectPage()
        for _, p in pairs(self.Pages) do p.Visible = false end
        for t, _ in pairs(self.Tabs) do
            CreateTween(t, 0.15, {TextColor3 = self.Theme.TextMuted, BackgroundTransparency = 1})
            local img = t:FindFirstChildOfClass("ImageLabel")
            if img then CreateTween(img, 0.15, {ImageColor3 = self.Theme.TextMuted}) end
        end
        
        -- Transição suave e limpa de subida de página
        pageFrame.Visible = true
        pageFrame.Position = UDim2.new(0, 0, 0, 10)
        CreateTween(pageFrame, 0.3, {Position = UDim2.new(0, 0, 0, 0)}, Enum.EasingStyle.Quint)
        
        CreateTween(tabBtn, 0.15, {TextColor3 = self.Theme.TextColor, BackgroundTransparency = 0.93})
        local activeImg = tabBtn:FindFirstChildOfClass("ImageLabel")
        if activeImg then CreateTween(activeImg, 0.15, {ImageColor3 = self.Theme.TextColor}) end
    end

    tabBtn.MouseButton1Click:Connect(SelectPage)
    tabBtn.MouseEnter:Connect(function() if not pageFrame.Visible then CreateTween(tabBtn, 0.1, {BackgroundTransparency = 0.96}) end end)
    tabBtn.MouseLeave:Connect(function() if not pageFrame.Visible then CreateTween(tabBtn, 0.1, {BackgroundTransparency = 1}) end end)

    table.insert(self.Pages, pageFrame)
    self.Tabs[tabBtn] = true

    if not self.FirstPage then self.FirstPage = SelectPage task.spawn(SelectPage) end

    local elements = {}
    local windowSelf = self

    -- Gerador de Cards Padrão Clean
    local function CreateCard()
        local card = Instance.new("Frame")
        card.BackgroundColor3 = windowSelf.Theme.CardBg
        local cc = Instance.new("UICorner") cc.CornerRadius = UDim.new(0, 5) cc.Parent = card
        local cs = Instance.new("UIStroke") cs.Color = windowSelf.Theme.Stroke cs.Thickness = 1 cs.Parent = card
        return card
    end

    function elements:CreateSection(titleText)
        local frame = Instance.new("Frame")
        frame.Size = UDim2.new(1, 0, 0, 24)
        frame.BackgroundTransparency = 1
        frame.Parent = pageFrame

        local lbl = Instance.new("TextLabel")
        lbl.Size = UDim2.new(1, 0, 1, 0)
        lbl.Text = titleText
        lbl.Font = windowSelf.Theme.FontBold
        lbl.TextSize = 11
        lbl.TextColor3 = windowSelf.Theme.Accent
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        lbl.TextYAlignment = Enum.TextYAlignment.Bottom
        lbl.BackgroundTransparency = 1
        lbl.Parent = frame
    end

    function elements:CreateButton(btnText, callback)
        callback = callback or function() end
        local card = CreateCard()
        card.Size = UDim2.new(1, 0, 0, 34)
        card.Parent = pageFrame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 1, 0)
