-- Muzysh Framework v1.0 - Professional UI Library
local Muzysh = {}
Muzysh.__index = Muzysh

-- Services
local TweenService = game:GetService("TweenService")
local UserInputService = game:GetService("UserInputService")
local Players = game:GetService("Players")
local CoreGui = game:GetService("CoreGui")

local LocalPlayer = Players.LocalPlayer

-- Design Tokens (Para fácil alteração visual)
local Style = {
    Background = Color3.fromRGB(18, 18, 18),
    Sidebar = Color3.fromRGB(22, 22, 22),
    Accent = Color3.fromRGB(215, 35, 35),
    TextColor = Color3.fromRGB(255, 255, 255),
    Muted = Color3.fromRGB(150, 150, 150),
    Stroke = Color3.fromRGB(45, 45, 45),
    Corner = UDim.new(0, 8)
}

-- Utility: Efeito de Tweening suave
local function Tween(obj, props, duration)
    TweenService:Create(obj, TweenInfo.new(duration or 0.25, Enum.EasingStyle.Quart, Enum.EasingDirection.Out), props):Play()
end

-- Construtor da Biblioteca
function Muzysh.Init(title)
    local self = setmetatable({}, Muzysh)
    
    self.Gui = Instance.new("ScreenGui")
    self.Gui.Name = "MuzyshHub"
    self.Gui.ResetOnSpawn = false
    self.Gui.Parent = (syn and syn.protect_gui and syn.protect_gui(self.Gui)) or CoreGui

    -- Main Container
    self.Main = Instance.new("Frame", self.Gui)
    self.Main.Size = UDim2.new(0, 650, 0, 420)
    self.Main.Position = UDim2.new(0.5, -325, 0.5, -210)
    self.Main.BackgroundColor3 = Style.Background
    self.Main.ClipsDescendants = true
    
    -- Efeito de borda elegante
    local corner = Instance.new("UICorner", self.Main) corner.CornerRadius = Style.Corner
    local stroke = Instance.new("UIStroke", self.Main) stroke.Color = Style.Stroke

    -- Sidebar
    self.Sidebar = Instance.new("Frame", self.Main)
    self.Sidebar.Size = UDim2.new(0, 180, 1, 0)
    self.Sidebar.BackgroundColor3 = Style.Sidebar
    
    -- Title
    local titleLbl = Instance.new("TextLabel", self.Sidebar)
    titleLbl.Size = UDim2.new(1, 0, 0, 50)
    titleLbl.Text = title or "Muzysh"
    titleLbl.TextColor3 = Style.TextColor
    titleLbl.Font = Enum.Font.GothamBold
    titleLbl.TextSize = 16
    titleLbl.BackgroundTransparency = 1
    
    -- Container de páginas
    self.PagesContainer = Instance.new("Frame", self.Main)
    self.PagesContainer.Size = UDim2.new(1, -180, 1, 0)
    self.PagesContainer.Position = UDim2.new(0, 180, 0, 0)
    self.PagesContainer.BackgroundTransparency = 1
    
    return self
end

-- Criador de Páginas
function Muzysh:CreatePage(name)
    local Page = Instance.new("ScrollingFrame", self.PagesContainer)
    Page.Size = UDim2.new(1, 0, 1, 0)
    Page.BackgroundTransparency = 1
    Page.ScrollBarThickness = 2
    Page.CanvasSize = UDim2.new(0, 0, 0, 0)
    
    local List = Instance.new("UIListLayout", Page)
    List.Padding = UDim.new(0, 10)
    List.HorizontalAlignment = Enum.HorizontalAlignment.Center
    
    local Padding = Instance.new("UIPadding", Page)
    Padding.PaddingTop = UDim.new(0, 20)

    local PageAPI = {}

    -- Elemento: Botão
    function PageAPI:Button(text, callback)
        local btn = Instance.new("TextButton", Page)
        btn.Size = UDim2.new(0, 420, 0, 45)
        btn.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        btn.Text = text
        btn.TextColor3 = Style.TextColor
        btn.Font = Enum.Font.Gotham
        
        Instance.new("UICorner", btn).CornerRadius = Style.Corner
        
        btn.MouseButton1Click:Connect(function()
            Tween(btn, {BackgroundColor3 = Style.Accent}, 0.1)
            task.wait(0.1)
            Tween(btn, {BackgroundColor3 = Color3.fromRGB(30, 30, 30)}, 0.3)
            callback()
        end)
    end

    -- Elemento: Toggle
    function PageAPI:Toggle(text, callback)
        local state = false
        local container = Instance.new("Frame", Page)
        container.Size = UDim2.new(0, 420, 0, 45)
        container.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        
        Instance.new("UICorner", container).CornerRadius = Style.Corner
        
        local lbl = Instance.new("TextLabel", container)
        lbl.Text = text
        lbl.TextColor3 = Style.TextColor
        lbl.Font = Enum.Font.Gotham
        lbl.Position = UDim2.new(0, 15, 0, 0)
        lbl.Size = UDim2.new(0.5, 0, 1, 0)
        lbl.BackgroundTransparency = 1
        lbl.TextXAlignment = Enum.TextXAlignment.Left
        
        local btn = Instance.new("TextButton", container)
        btn.Size = UDim2.new(0, 40, 0, 20)
        btn.Position = UDim2.new(1, -50, 0.5, -10)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btn.Text = ""
        Instance.new("UICorner", btn).CornerRadius = UDim.new(1, 0)
        
        btn.MouseButton1Click:Connect(function()
            state = not state
            Tween(btn, {BackgroundColor3 = state and Style.Accent or Color3.fromRGB(50, 50, 50)})
            callback(state)
        end)
    end

    return PageAPI
end

return Muzysh
