		realBtn.TextSize = 14
		realBtn.AutoButtonColor = false
		realBtn.Parent = btnFrame
		compJanitor:Add(realBtn)

		local rbCorner = Instance.new("UICorner")
		rbCorner.CornerRadius = UDim.new(0, 6)
		rbCorner.Parent = realBtn

		local ripple = Instance.new("Frame")
		ripple.Size = UDim2.new(0, 0, 0, 0)
		ripple.Position = UDim2.new(0.5, 0, 0.5, 0)
		ripple.AnchorPoint = Vector2.new(0.5, 0.5)
		ripple.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
		ripple.BackgroundTransparency = 0.7
		ripple.BorderSizePixel = 0
		ripple.ClipsDescendants = true
		ripple.ZIndex = 2
		ripple.Parent = realBtn

		local rippleCorner = Instance.new("UICorner")
		rippleCorner.CornerRadius = UDim.new(1, 0)
		rippleCorner.Parent = ripple

		local defaultSize = UDim2.new(1, -10, 1, -10)
		local pressedSize = UDim2.new(1, -14, 1, -14)
		local defaultPos = UDim2.new(0, 5, 0, 5)
		local pressedPos = UDim2.new(0, 7, 0, 7)

		local isPressed = false
		local isHovering = false

		local function playRipple(inputPosition)
			local relativePos = inputPosition - realBtn.AbsolutePosition
			local maxRadius = math.max(realBtn.AbsoluteSize.X, realBtn.AbsoluteSize.Y) * 1.5
			ripple.Position = UDim2.new(0, relativePos.X, 0, relativePos.Y)
			ripple.Size = UDim2.new(0, 0, 0, 0)
			ripple.BackgroundTransparency = 0.7
			local rippleTween = TweenService:Create(
				ripple,
				TweenInfo.new(0.5, Enum.EasingStyle.Quart, Enum.EasingDirection.Out),
				{ Size = UDim2.new(0, maxRadius, 0, maxRadius), BackgroundTransparency = 1 }
			)
			rippleTween:Play()
		end

		local hoverIn = realBtn.MouseEnter:Connect(function()
			isHovering = true
			Tween(realBtn, 0.2, {BackgroundColor3 = Theme.AccentHover})
		end)
		compJanitor:Add(hoverIn)

		local hoverOut = realBtn.MouseLeave:Connect(function()
			isHovering = false
			if not isPressed then
				Tween(realBtn, 0.2, {BackgroundColor3 = Theme.Accent})
			end
		end)
		compJanitor:Add(hoverOut)

		local downConn = realBtn.MouseButton1Down:Connect(function()
			isPressed = true
			Tween(realBtn, 0.1, {Size = pressedSize, Position = pressedPos}, Enum.EasingStyle.Quad)
			Tween(realBtn, 0.1, {BackgroundColor3 = Color3.fromRGB(180, 25, 25)})
		end)
		compJanitor:Add(downConn)

		local upConn = realBtn.MouseButton1Up:Connect(function()
			if isPressed then
				isPressed = false
				Tween(realBtn, 0.15, {Size = defaultSize, Position = defaultPos}, Enum.EasingStyle.Back)
				if isHovering then
					Tween(realBtn, 0.15, {BackgroundColor3 = Theme.AccentHover})
				else
					Tween(realBtn, 0.15, {BackgroundColor3 = Theme.Accent})
				end
				local mousePos = UserInputService:GetMouseLocation()
				playRipple(mousePos)
				callback()
			end
		end)
		compJanitor:Add(upConn)

		local leaveWhilePressed = realBtn.MouseLeave:Connect(function()
			if isPressed then
				isPressed = false
				Tween(realBtn, 0.15, {Size = defaultSize, Position = defaultPos}, Enum.EasingStyle.Back)
				Tween(realBtn, 0.15, {BackgroundColor3 = Theme.Accent})
			end
		end)
		compJanitor:Add(leaveWhilePressed)

		return {
			Destroy = function() compJanitor:Destroy() end,
			SetText = function(newText) realBtn.Text = newText end,
			SetCallback = function(newCallback) callback = newCallback or function() end end,
		}
	end

