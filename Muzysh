-- ============================================================================
-- ANIMATION MANAGER (GERENCIADOR CENTRAL DE TWEENS)
-- ============================================================================
local AnimationManager = {}
AnimationManager.__index = AnimationManager

function AnimationManager.new()
	local self = setmetatable({
		_activeTweens = {},
	}, AnimationManager)
	return self
end

function AnimationManager:Tween(instance, duration, properties, easing, direction)
	easing = easing or Enum.EasingStyle.Sine
	direction = direction or Enum.EasingDirection.Out
	self:Cancel(instance)
	local tweenInfo = TweenInfo.new(duration, easing, direction)
	local tween = TweenService:Create(instance, tweenInfo, properties)
	tween:Play()
	self._activeTweens[instance] = tween
	tween.Completed:Connect(function()
		if self._activeTweens[instance] == tween then
			self._activeTweens[instance] = nil
		end
	end)
	return tween
end

function AnimationManager:Cancel(instance)
	local existing = self._activeTweens[instance]
	if existing then
		existing:Cancel()
		self._activeTweens[instance] = nil
	end
end

function AnimationManager:CancelAll()
	for instance, tween in pairs(self._activeTweens) do
		tween:Cancel()
	end
	self._activeTweens = {}
end

function AnimationManager:IsAnimating(instance)
	return self._activeTweens[instance] ~= nil
end

