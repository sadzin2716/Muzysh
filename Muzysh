		label.Parent = sliderFrame

		local valLabel = Instance.new("TextLabel")
		valLabel.Size = UDim2.new(0.3, 0, 0, 24)
		valLabel.Position = UDim2.new(1, -112, 0, 4)
		valLabel.BackgroundTransparency = 1
		valLabel.Text = tostring(value)
		valLabel.TextColor3 = Theme.Accent
		valLabel.Font = Theme.FontMono
		valLabel.TextSize = 13
		valLabel.TextXAlignment = Enum.TextXAlignment.Right
		valLabel.Parent = sliderFrame

		local track = Instance.new("TextButton")
		track.Size = UDim2.new(1, -24, 0, 4)
		track.Position = UDim2.new(0, 12, 0, 36)
		track.BackgroundColor3 = Color3.fromRGB(38, 38, 45)
		track.Text = ""
		track.Parent = sliderFrame

		local tc = Instance.new("UICorner")
		tc.CornerRadius = UDim.new(1, 0)
		tc.Parent = track

		local fill = Instance.new("Frame")
		fill.Size = UDim2.new((value - min) / (max - min), 0, 1, 0)
		fill.BackgroundColor3 = Theme.Accent
		fill.BorderSizePixel = 0
		fill.Parent = track

		local fc = Instance.new("UICorner")
		fc.CornerRadius = UDim.new(1, 0)
		fc.Parent = fill

		local knob = Instance.new("Frame")
		knob.Size = UDim2.new(0, 12, 0, 12)
		knob.Position = UDim2.new((value - min) / (max - min), -6, 0.5, -6)
		knob.BackgroundColor3 = Theme.TextColor
		knob.Parent = track

		local kc = Instance.new("UICorner")
		kc.CornerRadius = UDim.new(1, 0)
		kc.Parent = knob

		local sliding = false

		local function UpdateSlider(input)
			local percentage = math.clamp((input.Position.X - track.AbsolutePosition.X) / track.AbsoluteWidth, 0, 1)
			value = math.floor(min + (max - min) * percentage)
			valLabel.Text = tostring(value)
			CreateTween(fill, 0.1, {Size = UDim2.new(percentage, 0, 1, 0)})
			CreateTween(knob, 0.1, {Position = UDim2.new(percentage, -6, 0.5, -6)})
			callback(value)
		end

		Muzysh.Janitor:Add(track.InputBegan:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = true
				CreateTween(knob, 0.1, {Size = UDim2.new(0, 14, 0, 14), BackgroundValue = Theme.AccentHover})
				UpdateSlider(input)
			end
		end))

		Muzysh.Janitor:Add(UserInputService.InputChanged:Connect(function(input)
			if sliding and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
				UpdateSlider(input)
			end
		end))

		Muzysh.Janitor:Add(UserInputService.InputEnded:Connect(function(input)
			if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
				sliding = false
				CreateTween(knob, 0.1, {Size = UDim2.new(0, 12, 0, 12), BackgroundValue = Theme.TextColor})
			end
		end))
	end

	-- [[ COMPONENTE: DROPDOWN SOBREPOSTO (ZINDEX FIX) ]]
	function elements:CreateDropdown(dropText, list, callback)
		callback = callback or function() end
		local isOpened = false

		local dropFrame = Instance.new("Frame")
		dropFrame.Size = UDim2.new(1, 0, 0, 42)
		dropFrame.BackgroundColor3 = Theme.CardBg
		dropFrame.ClipsDescendants = true
		dropFrame.ZIndex = 2
		dropFrame.Parent = pageFrame

		local dc = Instance.new("UICorner")
		dc.CornerRadius = UDim.new(0, 6)
		dc.Parent = dropFrame

		local ds = Instance.new("UIStroke")
		ds.Color = Theme.Stroke
		ds.Thickness = 1
		ds.Parent = dropFrame

		local mainBtn = Instance.new("TextButton")
		mainBtn.Size = UDim2.new(1, 0, 0, 42)
		mainBtn.BackgroundTransparency = 1
		mainBtn.Text = "   " .. dropText
		mainBtn.TextColor3 = Theme.TextColor
		mainBtn.Font = Theme.Font
		mainBtn.TextSize = 13
		mainBtn.TextXAlignment = Enum.TextXAlignment.Left
		mainBtn.ZIndex = 3
		mainBtn.Parent = dropFrame

		local arrow = Instance.new("TextLabel")
		arrow.Size = UDim2.new(0, 42, 0, 42)
		arrow.Position = UDim2.new(1, -42, 0, 0)
		arrow.BackgroundTransparency = 1
		arrow.Text = "└┘" -- Caractere simulando setas compactas ou use texto limpo
		arrow.Text = "▼"
		arrow.TextColor3 = Theme.TextMuted
		arrow.Font = Theme.Font
		arrow.TextSize = 10
		arrow.ZIndex = 3
		arrow.Parent = mainBtn

		local listHolder = Instance.new("Frame")
		listHolder.Size = UDim2.new(1, -20, 1, -48)
		listHolder.Position = UDim2.new(0, 10, 0, 44)
		listHolder.BackgroundTransparency = 1
		listHolder.ZIndex = 3
		listHolder.Parent = dropFrame

		local listLayout = Instance.new("UIListLayout")
		listLayout.Padding = UDim.new(0, 4)
		listLayout.Parent = listHolder

		for _, opt in pairs(list) do
			local optBtn = Instance.new("TextButton")
			optBtn.Size = UDim2.new(1, 0, 0, 32)
			optBtn.BackgroundColor3 = Color3.fromRGB(30, 30, 36)
			optBtn.Text = opt
			optBtn.TextColor3 = Theme.TextMuted
			optBtn.Font = Theme.Font
			optBtn.TextSize = 12
			optBtn.ZIndex = 4
			optBtn.Parent = listHolder

			local oc = Instance.new("UICorner")
			oc.CornerRadius = UDim.new(0, 5)
			oc.Parent = optBtn

			Muzysh.Janitor:Add(optBtn.MouseButton1Click:Connect(function()
				mainBtn.Text = "   " .. dropText .. " (" .. opt .. ")"
				isOpened = false
				dropFrame.ZIndex = 2
				CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 42)})
				CreateTween(arrow, 0.2, {Rotation = 0})
				callback(opt)
			end))
		end

		Muzysh.Janitor:Add(mainBtn.MouseButton1Click:Connect(function()
			isOpened = not isOpened
			if isOpened then
				dropFrame.ZIndex = 10 -- Eleva o componente sobre os outros ao expandir
				local neededHeight = 48 + (#list * 36)
				CreateTween(dropFrame, 0.25, {Size = UDim2.new(1, 0, 0, neededHeight)})
				CreateTween(arrow, 0.25, {Rotation = 180})
			else
				dropFrame.ZIndex = 2
				CreateTween(dropFrame, 0.2, {Size = UDim2.new(1, 0, 0, 42)})
				CreateTween(arrow, 0.2, {Rotation = 0})
			end
		end))
	end

	-- [[ COMPONENTE: TEXTBOX VALIDADA ]]
	function elements:CreateTextBox(placeholder, callback)
		callback = callback or function() end

		local boxFrame = Instance.new("Frame")
		boxFrame.Size = UDim2.new(1, 0, 0, 42)
		boxFrame.BackgroundColor3 = Theme.CardBg
		boxFrame.Parent = pageFrame

		local tbc = Instance.new("UICorner")
		tbc.CornerRadius = UDim.new(0, 6)
		tbc.Parent = boxFrame

		local tbs = Instance.new("UIStroke")
		tbs.Color = Theme.Stroke
		tbs.Thickness = 1
		tbs.Parent = boxFrame

		local box = Instance.new("TextBox")
		box.Size = UDim2.new(1, -24, 1, 0)
		box.Position = UDim2.new(0, 12, 0, 0)
		box.BackgroundTransparency = 1
		box.PlaceholderText = placeholder
		box.PlaceholderColor3 = Theme.TextMuted
		box.Text = ""
		box.TextColor3 = Theme.TextColor
		box.Font = Theme.Font
		box.TextSize = 13
		box.TextXAlignment = Enum.TextXAlignment.Left
		box.Parent = boxFrame

		Muzysh.Janitor:Add(box.Focused:Connect(function() CreateTween(tbs, 0.2, {Color = Theme.Accent}) end))
		Muzysh.Janitor:Add(box.FocusLost:Connect(function(enterPressed) 
			CreateTween(tbs, 0.2, {Color = Theme.Stroke})
			callback(box.Text, enterPressed)
		end))
	end

	return elements
end

-- [[ COLETOR DE LIMPEZA DO CORE DA UI ]]
function Muzysh:Destroy()
	if self.Janitor then
		self.Janitor:Clean()
	end
	if self.ScreenGui then
		self.ScreenGui:Destroy()
	end
end

return Muzysh
