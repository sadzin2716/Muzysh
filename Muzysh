        thumb.BackgroundColor3 = windowSelf.Theme.TextColor
        thumb.Parent = track
        local tbc = Instance.new("UICorner") tbc.CornerRadius = UDim.new(1,0) tbc.Parent = thumb

        local trigger = Instance.new("TextButton")
        trigger.Size = UDim2.new(1, 0, 3, 0)
        trigger.Position = UDim2.new(0, 0, -1, 0)
        trigger.BackgroundTransparency = 1
        trigger.Text = ""
        trigger.Parent = track

        local sliding = false
        local function update(inputPos)
            local pct = math.clamp((inputPos.X - track.AbsolutePosition.X) / track.AbsoluteSize.X, 0, 1)
            local raw = min + ((max - min) * pct)
            value = isDecimal and math.round(raw * 10) / 10 or math.floor(raw)
            valLbl.Text = tostring(value)
            CreateTween(fill, 0.05, {Size = UDim2.new(pct, 0, 1, 0)})
            CreateTween(thumb, 0.05, {Position = UDim2.new(pct, -5, 0.5, -5)})
            if flag then windowSelf.Flags[flag] = value windowSelf:SaveConfig() end
            callback(value)
        end

        trigger.InputBegan:Connect(function(i)
            if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then
                sliding = true pageFrame.ScrollingEnabled = false update(i.Position)
            end
        end)
        trigger.InputChanged:Connect(function(i)
            if sliding and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
                update(i.Position)
            end
        end)
        UserInputService.InputEnded:Connect(function(i)
            if sliding and (i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch) then
                sliding = false pageFrame.ScrollingEnabled = true
            end
        end)
        
        if flag and windowSelf.SavedFlags[flag] ~= nil then task.spawn(callback, value) end
    end

    function elements:CreateDropdown(dropText, list, flag, callback)
        callback = callback or function() end
        local open = false
        local selected = list[1] or ""
        if flag and windowSelf.SavedFlags[flag] ~= nil then selected = windowSelf.SavedFlags[flag] end
        if flag then windowSelf.Flags[flag] = selected end

        local card = CreateCard()
        card.Size = UDim2.new(1, 0, 0, 34)
        card.ClipsDescendants = true
        card.Parent = pageFrame

        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, 0, 0, 34)
        btn.BackgroundTransparency = 1
        btn.Text = "  " .. dropText .. (selected ~= "" and " (" .. selected .. ")" or "")
        btn.TextColor3 = windowSelf.Theme.TextColor
        btn.Font = windowSelf.Theme.Font
        btn.TextSize = 12
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.Parent = card

        local arrow = Instance.new("ImageLabel")
        arrow.Size = UDim2.new(0, 12, 0, 12)
        arrow.Position = UDim2.new(1, -24, 0.5, -6)
        arrow.BackgroundTransparency = 1
        arrow.Image = "rbxassetid://11422142913" -- Seta limpa e minimalista
        arrow.ImageColor3 = windowSelf.Theme.TextMuted
        arrow.Parent = btn

        local holder = Instance.new("ScrollingFrame")
        holder.Size = UDim2.new(1, -16, 1, -38)
        holder.Position = UDim2.new(0, 8, 0, 36)
        holder.BackgroundTransparency = 1
        holder.ScrollBarThickness = 0
        holder.Parent = card
        local hl = Instance.new("UIListLayout") hl.Padding = UDim.new(0, 2) hl.Parent = holder

        for _, opt in ipairs(list) do
            local oBtn = Instance.new("TextButton")
            oBtn.Size = UDim2.new(1, 0, 0, 24)
            oBtn.BackgroundColor3 = Color3.fromRGB(36, 36, 36)
            oBtn.Text = "  " .. opt
            oBtn.TextColor3 = windowSelf.Theme.TextMuted
            oBtn.Font = windowSelf.Theme.Font
            oBtn.TextSize = 11
            oBtn.TextXAlignment = Enum.TextXAlignment.Left
            oBtn.Parent = holder
            local oc = Instance.new("UICorner") oc.CornerRadius = UDim.new(0, 4) oc.Parent = oBtn

            oBtn.MouseButton1Click:Connect(function()
                selected = opt
                btn.Text = "  " .. dropText .. " (" .. opt .. ")"
                open = false
                card.ZIndex = 1
                CreateTween(card, 0.15, {Size = UDim2.new(1, 0, 0, 34)})
                CreateTween(arrow, 0.15, {Rotation = 0})
                if flag then windowSelf.Flags[flag] = selected windowSelf:SaveConfig() end
                callback(opt)
            end)
        end

        btn.MouseButton1Click:Connect(function()
            open = not open
            if open then
                card.ZIndex = 10 -- Evita sobreposição errada
                local targetH = math.clamp(38 + (#list * 26), 34, 130)
                CreateTween(card, 0.15, {Size = UDim2.new(1, 0, 0, targetH)})
                CreateTween(arrow, 0.15, {Rotation = 180})
            else
                card.ZIndex = 1
                CreateTween(card, 0.15, {Size = UDim2.new(1, 0, 0, 34)})
                CreateTween(arrow, 0.15, {Rotation = 0})
            end
        end)
        if flag and windowSelf.SavedFlags[flag] ~= nil then task.spawn(callback, selected) end
    end

    function elements:CreateTextBox(placeholder, flag, callback)
        callback = callback or function() end
        local currentText = ""
        if flag and windowSelf.SavedFlags[flag] ~= nil then currentText = windowSelf.SavedFlags[flag] end
        if flag then windowSelf.Flags[flag] = currentText end

        local card = CreateCard()
        card.Size = UDim2.new(1, 0, 0, 34)
        card.Parent = pageFrame
        local stroke = card:FindFirstChildOfClass("UIStroke")

        local box = Instance.new("TextBox")
        box.Size = UDim2.new(1, -24, 1, 0)
        box.Position = UDim2.new(0, 12, 0, 0)
        box.BackgroundTransparency = 1
        box.PlaceholderText = placeholder
        box.PlaceholderColor3 = windowSelf.Theme.TextMuted
        box.Text = currentText
        box.TextColor3 = windowSelf.Theme.TextColor
        box.Font = windowSelf.Theme.Font
        box.TextSize = 12
        box.TextXAlignment = Enum.TextXAlignment.Left
        box.Parent = card

        box.Focused:Connect(function() if stroke then CreateTween(stroke, 0.1, {Color = windowSelf.Theme.Accent}) end end)
        box.FocusLost:Connect(function(ep)
            if stroke then CreateTween(stroke, 0.1, {Color = windowSelf.Theme.Stroke}) end
            currentText = box.Text
            if flag then windowSelf.Flags[flag] = currentText windowSelf:SaveConfig() end
            callback(currentText, ep)
        end)
        if flag and windowSelf.SavedFlags[flag] ~= nil and currentText ~= "" then task.spawn(callback, currentText, false) end
    end

    return elements
end

return Muzysh
