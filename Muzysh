		local switch = Instance.new("Frame")
		switch.Size = UDim2.new(0, 46, 0, 24)
		switch.Position = UDim2.new(1, -58, 0.5, -12)
		switch.BackgroundColor3 = state and Theme.Accent or Color3.fromRGB(50, 50, 50)
		switch.Parent = toggleFrame

		local swCorner = Instance.new("UICorner")
		swCorner.CornerRadius = UDim.new(1, 0)
		swCorner.Parent = switch

		local sliderCircle = Instance.new("Frame")
		sliderCircle.Size = UDim2.new(0, 18, 0, 18)
		sliderCircle.Position = state and UDim2.new(1, -22, 0.5, -9) or UDim2.new(0, 4, 0.5, -9)
		sliderCircle.BackgroundColor3 = Theme.TextColor
		sliderCircle.Parent = switch

		local scCorner = Instance.new("UICorner")
		scCorner.CornerRadius = UDim.new(1, 0)
		scCorner.Parent = sliderCircle

		local stateIndicator = Instance.new("TextLabel")
		stateIndicator.Size = UDim2.new(0, 20, 1, 0)
		stateIndicator.Position = state and UDim2.new(0, 6, 0, 0) or UDim2.new(1, -26, 0, 0)
		stateIndicator.BackgroundTransparency = 1
		stateIndicator.Text = state and "ON" or "OFF"
		stateIndicator.TextColor3 = state and Theme.TextColor or Color3.fromRGB(100, 100, 100)
		stateIndicator.Font = Theme.Font
		stateIndicator.TextSize = 10
		stateIndicator.TextXAlignment = Enum.TextXAlignment.Center
		stateIndicator.Parent = switch

		local function updateVisual(animate)
			if state then
				if animate then
					Tween(switch, 0.25, {BackgroundColor3 = Theme.Accent})
					Tween(sliderCircle, 0.25, {Position = UDim2.new(1, -22, 0.5, -9)}, Enum.EasingStyle.Back)
					Tween(stateIndicator, 0.2, {TextColor3 = Theme.TextColor, Position = UDim2.new(0, 6, 0, 0)})
				else
					switch.BackgroundColor3 = Theme.Accent
					sliderCircle.Position = UDim2.new(1, -22, 0.5, -9)
					stateIndicator.TextColor3 = Theme.TextColor
					stateIndicator.Position = UDim2.new(0, 6, 0, 0)
				end
				stateIndicator.Text = "ON"
				Tween(label, 0.2, {TextColor3 = Theme.TextColor})
			else
				if animate then
					Tween(switch, 0.25, {BackgroundColor3 = Color3.fromRGB(50, 50, 50)})
					Tween(sliderCircle, 0.25, {Position = UDim2.new(0, 4, 0.5, -9)}, Enum.EasingStyle.Back)
					Tween(stateIndicator, 0.2, {TextColor3 = Color3.fromRGB(100, 100, 100), Position = UDim2.new(1, -26, 0, 0)})
				else
					switch.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
					sliderCircle.Position = UDim2.new(0, 4, 0.5, -9)
					stateIndicator.TextColor3 = Color3.fromRGB(100, 100, 100)
					stateIndicator.Position = UDim2.new(1, -26, 0, 0)
				end
				stateIndicator.Text = "OFF"
				Tween(label, 0.2, {TextColor3 = Theme.TextMuted})
			end
		end

		updateVisual(false)

		local clickConn = clickArea.MouseButton1Click:Connect(function()
			state = not state
			updateVisual(true)
			callback(state)
		end)
		compJanitor:Add(clickConn)

		local switchHoverIn = switch.MouseEnter:Connect(function()
			Tween(switch, 0.15, {Size = UDim2.new(0, 50, 0, 26)})
			Tween(switch, 0.15, {Position = UDim2.new(1, -62, 0.5, -13)})
		end)
		local switchHoverOut = switch.MouseLeave:Connect(function()
			Tween(switch, 0.15, {Size = UDim2.new(0, 46, 0, 24)})
			Tween(switch, 0.15, {Position = UDim2.new(1, -58, 0.5, -12)})
		end)
		compJanitor:Add(switchHoverIn)
		compJanitor:Add(switchHoverOut)

		return {
			Destroy = function() compJanitor:Destroy() end,
			SetValue = function(value) if value ~= state then state = value; updateVisual(true) end end,
			GetValue = function() return state end,
		}
	end

